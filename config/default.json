{
  "version": 1,
  "theme": "mono",
  "bar": {
    "id": "cn.bar",
    "position": "top",
    "transparent": false,
    "layout": {
      "left": [
        {
          "id": "cn.launcher"
        },
        {
          "id": "cn.workspaces"
        },
        {
          "id": "cn.active-window"
        },
        {
          "id": "cn.media"
        }
      ],
      "center": [
        {
          "id": "cn.clock",
          "format": "ddd HH:mm",
          "formatAlt": "HH:mm:ss"
        }
      ],
      "right": [
        {
          "id": "cn.indicators"
        },
        {
          "id": "cn.weather"
        },
        {
          "id": "cn.tray"
        },
        {
          "id": "cn.network"
        },
        {
          "id": "cn.bluetooth"
        },
        {
          "id": "cn.audio"
        },
        {
          "id": "cn.power"
        },
        {
          "id": "cn.screenshot"
        },
        {
          "id": "cn.menu"
        }
      ]
    }
  },
  "notifications": {
    "timeout": 6000,
    "maxPopups": 4,
    "historyLimit": 50,
    "inlineReply": true
  },
  "launcher": {
    "terminal": "kitty",
    "terminalApps": []
  },
  "background": {
    "enabled": true,
    "path": "",
    "dir": "",
    "mode": "fill",
    "perWorkspace": {},
    "force": false
  },
  "idle": {
    "dimAc": 60,
    "dimBattery": 0,
    "screenOffAc": 120,
    "screenOffBattery": 300,
    "lock": 300,
    "lockScreenOff": 10,
    "lockOnSleep": true,
    "lockOnLockSignal": true,
    "lockOnLidClose": true
  },
  "lock": {
    "background": "wallpaper",
    "blur": 1.0,
    "scrim": 1.0,
    "showUser": true
  },
  "weather": {
    "autoLocate": true,
    "unit": "metric",
    "intervalMinutes": 15,
    "place": null
  },
  "language": "en",
  "clock": {
    "zone": null
  },
  "agentDesktop": {
    "enabled": true,
    "desktops": []
  },
  "desktopApplications": {
    "browser": "chrome",
    "rules": {
      "chrome": {
        "executables": [
          "google-chrome-stable",
          "google-chrome",
          "chromium",
          "chromium-browser",
          "google-chrome-beta",
          "google-chrome-unstable"
        ],
        "backend": "chromium",
        "profile": "chrome",
        "arguments": [
          "--user-data-dir={profile}",
          "--ozone-platform=wayland",
          "--no-first-run",
          "--no-default-browser-check"
        ],
        "reservedArguments": [
          "--user-data-dir",
          "--profile",
          "-profile"
        ]
      },
      "firefox": {
        "executables": [
          "firefox",
          "firefox-esr",
          "firefox-developer-edition"
        ],
        "profile": "firefox",
        "arguments": [
          "--no-remote",
          "--profile",
          "{profile}"
        ],
        "reservedArguments": [
          "--remote-debugging",
          "--user-data-dir",
          "--profile",
          "-profile"
        ]
      },
      "chatgpt": {
        "executables": [
          "chatgpt",
          "ChatGPT",
          "codex-launcher"
        ],
        "scope": "secondary",
        "profile": "chatgpt",
        "arguments": [
          "--user-data-dir={profile}"
        ],
        "environment": {
          "CODEX_ELECTRON_USER_DATA_PATH": "{profile}"
        },
        "reservedArguments": [
          "--user-data-dir"
        ]
      }
    }
  }
}
