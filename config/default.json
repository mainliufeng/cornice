{
  "version": 1,
  "theme": "mono",
  "bar": {
    "id": "cn.bar",
    "position": "top",
    "transparent": false,
    "layout": {
      "left": [
        {
          "id": "cn.launcher"
        },
        {
          "id": "cn.workspaces"
        },
        {
          "id": "cn.active-window"
        },
        {
          "id": "cn.media"
        }
      ],
      "center": [
        {
          "id": "cn.clock",
          "format": "ddd HH:mm",
          "formatAlt": "HH:mm:ss"
        }
      ],
      "right": [
        {
          "id": "cn.indicators"
        },
        {
          "id": "cn.tray"
        },
        {
          "id": "cn.network"
        },
        {
          "id": "cn.bluetooth"
        },
        {
          "id": "cn.audio"
        },
        {
          "id": "cn.power"
        }
      ]
    }
  },
  "notifications": {
    "timeout": 6000,
    "maxPopups": 4,
    "historyLimit": 50
  },
  "launcher": {
    "terminal": "kitty",
    "terminalApps": []
  }
}
