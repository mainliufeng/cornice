{
  "version": 1,
  "theme": "mono",
  "bar": {
    "id": "cn.bar",
    "position": "top",
    "transparent": false,
    "layout": {
      "left": [
        {
          "id": "cn.launcher"
        },
        {
          "id": "cn.workspaces"
        },
        {
          "id": "cn.active-window"
        },
        {
          "id": "cn.media"
        }
      ],
      "center": [
        {
          "id": "cn.clock",
          "format": "ddd HH:mm",
          "formatAlt": "HH:mm:ss"
        }
      ],
      "right": [
        {
          "id": "cn.indicators"
        },
        {
          "id": "cn.weather"
        },
        {
          "id": "cn.tray"
        },
        {
          "id": "cn.network"
        },
        {
          "id": "cn.bluetooth"
        },
        {
          "id": "cn.audio"
        },
        {
          "id": "cn.keylayout"
        },
        {
          "id": "cn.power"
        }
      ]
    }
  },
  "notifications": {
    "timeout": 6000,
    "maxPopups": 4,
    "historyLimit": 50,
    "inlineReply": true
  },
  "launcher": {
    "terminal": "kitty",
    "terminalApps": []
  },
  "background": {
    "enabled": true,
    "path": "",
    "dir": "",
    "mode": "fill",
    "perWorkspace": {},
    "force": false
  },
  "idle": {
    "dimAc": 60,
    "dimBattery": 0,
    "screenOffAc": 120,
    "screenOffBattery": 300,
    "lock": 300,
    "lockOnSleep": true,
    "lockOnLockSignal": true,
    "lockOnLidClose": true
  },
  "lock": {
    "background": "wallpaper",
    "blur": 1.0,
    "scrim": 1.0
  },
  "weather": {
    "autoLocate": true,
    "city": "",
    "place": "",
    "latitude": null,
    "longitude": null,
    "unit": "metric",
    "intervalMinutes": 15
  }
}
