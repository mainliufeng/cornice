#!/usr/bin/env bash
# cornice doctor — why isn't it working, and what will it conflict with?
#
# Read-only. Never edits a config, never restarts anything.
set -uo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
bin_dir=$(dirname "$self")

# hyprctl/grim must work even when this runs from a TTY or a shell that
# inherited a stale Hyprland instance signature.
# shellcheck source=/dev/null
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cornice-env.sh"

# --log: keep a copy of the report in the state dir (used by cornice-launch to
# record the state of every session, and by `cornice health` to read it back).
log_to=""
if [[ ${1:-} == "--log" ]]; then
  log_to="${XDG_STATE_HOME:-$HOME/.local/state}/cornice/doctor-last.txt"
  mkdir -p "$(dirname "$log_to")"
  exec > >(tee "$log_to") 2>&1
fi
prefix="${CORNICE_PATH:-$(cd "$bin_dir/.." && pwd)}"
export CORNICE_PATH="$prefix"
config_dir="$prefix/shell"
qs="$bin_dir/cornice-qs"

fail=0
ok()   { printf '  \033[32mok\033[0m    %s\n' "$1"; }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$1"; }
bad()  { printf '  \033[31mfail\033[0m  %s\n' "$1"; fail=1; }
section() { printf '\n%s\n' "$1"; }

section "Paths"
ok "prefix:      $prefix"
ok "shell:       $config_dir"
ok "user config: ${XDG_CONFIG_HOME:-$HOME/.config}/cornice/config.json"

section "Dependencies"
if version=$("$qs" --version 2>/dev/null | head -1); then
  ok "quickshell:  $version"
  if [[ -z ${CORNICE_QS:-} ]] && ! command -v quickshell >/dev/null 2>&1; then
    warn "using the user-local vendor tree; install the package for daily use: sudo pacman -S quickshell"
  fi
else
  bad "quickshell not found — sudo pacman -S quickshell (or set CORNICE_QS)"
fi
command -v jq >/dev/null 2>&1 && ok "jq:          $(jq --version)" \
  || { command -v python3 >/dev/null 2>&1 && warn "no jq; using python3 to read manifests" || bad "need jq or python3 to read plugin manifests"; }
if command -v hyprctl >/dev/null 2>&1; then
  ok "hyprctl:     $(command -v hyprctl)"
else
  bad "hyprctl not found (Cornice targets Hyprland)"
fi

section "Session"
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  ok "Hyprland:    running ($HYPRLAND_INSTANCE_SIGNATURE)"
else
  warn "no Hyprland session in this environment — widgets will not show, IPC will not answer"
fi
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  ok "Wayland:     $WAYLAND_DISPLAY"
else
  warn "WAYLAND_DISPLAY is empty — Quickshell needs a Wayland session"
fi

section "Fonts"
fonts=$(fc-list 2>/dev/null || true)
if grep -qi "nerd font" <<<"$fonts"; then
  ok "Nerd Font:   $(grep -i 'nerd font' <<<"$fonts" | head -1 | cut -d: -f2 | sed 's/^ *//')"
else
  warn "no Nerd Font found — bar icons will render as boxes"
fi

section "Conflicts"
for proc in waybar mako dunst swayosd-server hyprlock; do
  if pgrep -x "$proc" >/dev/null 2>&1; then
    case $proc in
      hyprlock) warn "$proc is running (Cornice has no lock screen yet — unrelated)" ;;
      *) warn "$proc is running: it will overlap the bar or fight over notifications" ;;
    esac
  fi
done
if command -v busctl >/dev/null 2>&1; then
  owner=$(busctl --user --timeout=1s call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus GetNameOwner s org.freedesktop.Notifications 2>/dev/null || true)
  if [[ -n $owner ]]; then
    if [[ ${XDG_CURRENT_DESKTOP:-} == *Hyprland* ]]; then
      warn "another notification daemon owns org.freedesktop.Notifications — stop it or cornice will not receive notifications"
    else
      warn "another notification daemon owns org.freedesktop.Notifications (expected: this is not a Hyprland session)"
    fi
  else
    ok "org.freedesktop.Notifications is free"
  fi
fi
pgrep -x waybar >/dev/null 2>&1 && warn "waybar is in your exec-once: comment it out before switching"

section "Notifications"
if command -v busctl >/dev/null 2>&1; then
  owner=$(busctl --user list --no-pager 2>/dev/null | awk '$1=="org.freedesktop.Notifications" {print $2, $3}')
  if [[ -z $owner ]]; then
    warn "nobody owns org.freedesktop.Notifications — notifications are going nowhere"
  elif [[ $owner == *quickshell* ]]; then
    ok "cornice owns org.freedesktop.Notifications (pid ${owner%% *})"
  else
    bad "another daemon owns org.freedesktop.Notifications: $owner"
    warn "stop it, or set \"notifications\": {\"takeover\": true} in ~/.config/cornice/config.json"
  fi

  competing=""
  for daemon in mako dunst swaync fnott; do
    pgrep -x "$daemon" >/dev/null 2>&1 && competing="$competing $daemon"
  done
  if [[ -n $competing ]]; then
    warn "competing notification daemon(s) running:$competing"
  else
    ok "no competing notification daemon"
  fi
fi

# Count only shells belonging to *this* session: the test harnesses run their
# own quickshell instances under a private XDG_RUNTIME_DIR.
shell_instances=0
for pid in $(pgrep -x quickshell 2>/dev/null); do
  runtime=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^XDG_RUNTIME_DIR=//p')
  [[ $runtime == "${XDG_RUNTIME_DIR:-/tmp}" ]] && shell_instances=$((shell_instances + 1))
done
if ((shell_instances == 1)); then
  ok "exactly one shell instance"
elif ((shell_instances == 0)); then
  warn "no shell instance running"
else
  warn "$shell_instances shell instances — duplicates cannot own the notification bus name (restart: cornice restart)"
fi

section "Background"
other_wallpaper=""
for tool in mpvpaper hyprpaper swaybg swww-daemon wbg; do
  pgrep -x "$tool" >/dev/null 2>&1 && other_wallpaper="$tool" && break
done
if [[ -n $other_wallpaper ]]; then
  ok "another wallpaper tool is running ($other_wallpaper) — cornice's background layer stays idle"
else
  bg_enabled=$(jq -r '.background.enabled // false' "$prefix/config/default.json" 2>/dev/null || echo false)
  user_config="${XDG_CONFIG_HOME:-$HOME/.config}/cornice/config.json"
  [[ -r $user_config ]] && bg_enabled=$(jq -r '.background.enabled // '"$bg_enabled"'' "$user_config" 2>/dev/null || echo "$bg_enabled")
  if [[ $bg_enabled == "true" ]]; then
    ok "background layer enabled"
  else
    warn "no wallpaper tool running (mpvpaper absent) and cornice's background layer is off — the desktop will show a flat colour"
  fi
fi

section "Configuration"
defaults="$prefix/config/default.json"
user_config="${XDG_CONFIG_HOME:-$HOME/.config}/cornice/config.json"
theme_override="${XDG_CONFIG_HOME:-$HOME/.config}/cornice/theme.json"
if [[ -f $defaults ]]; then
  jq -e . "$defaults" >/dev/null 2>&1 && ok "defaults:    valid JSON ($defaults)" || bad "invalid JSON: $defaults"
else
  bad "missing $defaults"
fi
if [[ -f $user_config ]]; then
  jq -e . "$user_config" >/dev/null 2>&1 && ok "user config: valid JSON ($user_config)" || bad "invalid JSON: $user_config"
  ok "user config overrides: $(jq -c 'paths(scalars) | join(".")' "$user_config" 2>/dev/null | paste -sd, - || echo "(none)")"
else
  ok "user config: none yet — defaults in use (write only what you want to differ)"
fi
[[ -f $theme_override ]] && ok "theme override: $theme_override" || true

section "Shell"
socket_path="${XDG_RUNTIME_DIR:-/tmp}/cornice-${USER:-user}.sock"
if [[ -S $socket_path ]]; then
  ok "ipc socket:  $socket_path"
  if timeout 3 "$bin_dir/cornice" ipc shell targets >/dev/null 2>&1; then
    ok "running shell targets: $(timeout 3 "$bin_dir/cornice" ipc shell targets | tr -d '[]"' )"
  else
    warn "a socket exists but the shell does not answer — stale socket, or a shell still starting"
  fi
else
  ok "no running shell (nothing to talk to yet)"
fi

hypr_conf="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf"
if [[ -r $hypr_conf ]]; then
  if grep -qE "^\s*exec-once\s*=.*cornice-launch" "$hypr_conf"; then
    ok "hyprland.conf starts cornice"
  else
    warn "hyprland.conf does not start cornice — add: exec-once = cornice-launch"
  fi
fi

section "Plugins"
count=0
for manifest in "$config_dir"/plugins/*/manifest.json "$config_dir"/plugins/*/*/manifest.json; do
  [[ -f $manifest ]] || continue
  count=$((count + 1))
  if jq -e . "$manifest" >/dev/null 2>&1; then
    id=$(jq -r '.id // "?"' "$manifest")
    ok "$id  (${manifest%/manifest.json})"
  else
    bad "invalid manifest: $manifest"
  fi
done
((count == 0)) && bad "no plugins found under $config_dir/plugins"

section "Snippet for hyprland.conf"
printf '  exec-once = cornice-launch          # needs %s on PATH\n' "$bin_dir"

[[ $fail == 0 ]] && printf '\nall checks passed\n' || printf '\nsomething failed above\n'
exit "$fail"
