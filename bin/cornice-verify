#!/usr/bin/env bash
# cornice verify — check the running shell inside your real session.
#
# Where test/headless-verify.sh builds a private compositor to test cornice in
# isolation, this one talks to the shell you are actually looking at: it opens
# panels, sends a notification and screenshots the result. Run it after logging
# into Hyprland.
set -uo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
bin_dir=$(dirname "$self")
prefix="${CORNICE_PATH:-$(cd "$bin_dir/.." && pwd)}"
export CORNICE_PATH="$prefix"
export PATH="$bin_dir:$PATH"

result=0

# hyprctl/grim must work even when this runs from a TTY or a shell that
# inherited a stale Hyprland instance signature.
# shellcheck source=/dev/null
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cornice-env.sh"

pass() { printf '  \033[32mPASS\033[0m  %s\n' "$1"; }
fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; result=1; }
warn() { printf '  \033[33mWARN\033[0m  %s\n' "$1"; }
section() { printf '\n== %s\n' "$1"; }

ipc() { timeout 5 cornice ipc "$@" 2>&1; }

section "session"
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  fail "no Hyprland session in this environment (HYPRLAND_INSTANCE_SIGNATURE is unset)"
  warn "run this from a terminal inside Hyprland"
  exit 1
fi
pass "Hyprland session: $HYPRLAND_INSTANCE_SIGNATURE"

if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  fail "WAYLAND_DISPLAY is unset — this is not a graphical session"
  exit 1
fi

section "shell"
if ! timeout 5 cornice ping >/dev/null 2>&1; then
  fail "the shell is not answering — start it with: cornice start"
  exit 1
fi
pass "ping: $(timeout 5 cornice ping)"
pass "socket: $(cornice socket)"

plugin_count=$(timeout 5 cornice plugins | jq 'length' 2>/dev/null || echo 0)
if ((plugin_count >= 15)); then pass "plugins: $plugin_count"; else fail "only $plugin_count plugins discovered"; fi

bar=$(timeout 5 cornice widgets | jq -r '[.[].id] | length' 2>/dev/null || echo 0)
if ((bar > 0)); then pass "bar widgets available: $bar"; else fail "no bar widgets registered"; fi

for target in shell notifications osd; do
  if timeout 5 cornice targets | jq -e --arg t "$target" 'index($t)' >/dev/null 2>&1; then
    pass "ipc target: $target"
  else
    fail "ipc target missing: $target"
  fi
done

section "the bar you are looking at"
if command -v hyprctl >/dev/null 2>&1; then
  # A shell that was just (re)started may not have mapped its bar yet, so give it
  # a moment instead of reporting a false failure.
  layers=0
  for _ in $(seq 1 20); do
    layers=$(hyprctl layers 2>/dev/null | grep -c "cornice-bar" || true)
    ((layers > 0)) && break
    sleep 0.25
  done
  if ((layers > 0)); then pass "a cornice-bar layer surface is mapped"
  else
    fail "no cornice-bar layer surface found — is waybar still running?"
    warn "check: hyprctl layers | grep cornice"
  fi
fi

section "panels"
for id in cn.clock cn.audio cn.network cn.bluetooth cn.power cn.notifications cn.launcher; do
  timeout 5 cornice ipc shell summon "$id" '{}' >/dev/null 2>&1
  sleep 0.3
  state=$(timeout 5 cornice ipc shell debug 2>/dev/null | jq -r --arg id "$id" '.openStates[] | select(startswith($id + "=")) | split("=")[1]' 2>/dev/null)
  timeout 5 cornice ipc shell hide "$id" >/dev/null 2>&1
  if [[ $state == "open" ]]; then pass "$id opens"
  else fail "$id did not open (state: ${state:-unknown})"; fi
done

section "notifications"
if command -v notify-send >/dev/null 2>&1; then
  status=$(timeout 5 cornice ipc notifications status 2>/dev/null || echo '{}')
  if [[ $(jq -r '.serverReady' <<<"$status") == "true" ]]; then
    pass "notification server is serving org.freedesktop.Notifications"
  else
    fail "the notification server is not ready"
  fi
  notify-send -a cornice-verify "cornice verify" "if you can see this, notifications work" >/dev/null 2>&1
  sleep 1
  status=$(timeout 5 cornice ipc notifications status 2>/dev/null || echo '{}')
  if [[ $(jq -r '.popups // 0' <<<"$status") -gt 0 ]]; then
    pass "a notification arrived and popped up"
  else
    fail "the notification never showed up: $status"
  fi
fi

section "on-screen display"
if ipc osd show volume 0.5 "" >/dev/null 2>&1; then
  sleep 0.4
  if [[ $(ipc osd status | jq -r '.opened // false') == "true" ]]; then
    pass "OSD opened"
  else
    fail "OSD did not open"
  fi
  ipc osd hide >/dev/null 2>&1
else
  fail "OSD does not answer on its own target"
fi

section "screenshot"
if command -v hyprctl >/dev/null 2>&1 && [[ $(hyprctl locked 2>/dev/null) == "true" ]]; then
  warn "session is locked — skipping the visual checks (unlock and re-run)"
elif command -v grim >/dev/null 2>&1; then
  shot="${TMPDIR:-/tmp}/cornice-verify.png"
  timeout 5 cornice ipc shell summon cn.audio '{}' >/dev/null 2>&1
  sleep 0.8
  if timeout 8 grim "$shot" 2>/dev/null; then
    pass "screenshot: $shot"
  else
    warn "grim failed"
  fi
  timeout 5 cornice ipc shell hide cn.audio >/dev/null 2>&1
else
  warn "grim not installed; no screenshot"
fi

echo
((result == 0)) && echo "RESULT: all checks passed" || echo "RESULT: failures above"
exit "$result"
