#!/usr/bin/env bash
# cornice-tray-activate — click a status-notifier menu entry for real.
#
# Why this exists: Quickshell hands menu entries to QML as generic QsMenuEntry
# objects. They have display() (which only opens submenus) but not the
# DBusMenuItem.sendTriggered() needed to activate a leaf entry, and the item's
# bus name is not exposed to QML at all. So the shell cannot activate a tray menu
# entry on its own — this helper does it over DBus, the way the app expects.
#
# Two details that matter:
#   * the Event() call must carry a real timestamp; several apps (ChatGPT among
#     them) ignore or hang on timestamp 0
#   * menu item ids are rebuilt whenever the menu is opened, so the layout has to
#     be fetched right before activating, never cached
#
#   cornice-tray-activate --title "ChatGPT" --label "Quit"
set -uo pipefail

title=""
ident=""
label=""
index=0
menu_path=""
dry=0
list=0
while (($#)); do
  case "$1" in
    --title) title="${2:-}"; shift 2 ;;
    --id) ident="${2:-}"; shift 2 ;;
    --label) label="${2:-}"; shift 2 ;;
    --path) menu_path="${2:-}"; shift 2 ;;
    --index)
      index="${2:-0}"
      [[ $index =~ ^[0-9]+$ ]] || index=0
      shift 2
      ;;
    --dry-run) dry=1; shift ;;
    --check)
      # Print the values the event would carry, so a test can assert them
      # without needing a live tray item.
      printf 'timestamp=%s\n' "$(( $(date +%s%3N) % 4294967296 ))"
      exit 0
      ;;
    --list) list=1; shift ;;
    -h | --help) sed -n '2,20p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "cornice-tray-activate: unknown option '$1'" >&2; exit 2 ;;
  esac
done

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

# The watcher lists every item as "<bus name><object path>".
items=$(gdbus call --session --dest org.kde.StatusNotifierWatcher \
  --object-path /StatusNotifierWatcher \
  --method org.freedesktop.DBus.Properties.Get \
  org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>/dev/null |
  grep -o "'[^']*'" | tr -d "'")

[[ -n $items ]] || { echo "cornice-tray-activate: no status notifier items registered" >&2; exit 1; }

# gdbus prints values as (<'value'>,); pull the first quoted string out of that.
grab() {
  # gdbus prints values as (<'value'>,) or (<objectpath '/value'>,): keep the
  # first single-quoted run.
  sed -E "s/.*'([^']*)'.*/\1/"
}

sni_prop() { # sni_prop <service> <path> <property>
  gdbus call --session --dest "$1" --object-path "$2" \
    --method org.freedesktop.DBus.Properties.Get org.kde.StatusNotifierItem "$3" 2>/dev/null | grab
}

sni_title() { sni_prop "$1" "$2" Title; }
sni_id() { sni_prop "$1" "$2" Id; }
sni_menu() { sni_prop "$1" "$2" Menu; }

if ((list)); then
  while read -r entry; do
    [[ -n $entry ]] || continue
    svc="${entry%%/*}"
    path="/${entry#*/}"
    printf '%-52s %-34s %s\n' "$svc" "$path" "$(sni_id "$svc" "$path")"
  done <<<"$items"
  exit 0
fi

[[ -n $label ]] || { echo "usage: cornice-tray-activate (--id ID | --title T) --label L" >&2; exit 2; }
[[ -n $ident || -n $title ]] || { echo "cornice-tray-activate: pass --id or --title" >&2; exit 2; }

match_service=""
match_path=""
while read -r entry; do
  [[ -n $entry ]] || continue
  svc="${entry%%/*}"
  path="/${entry#*/}"
  if [[ -n $ident ]]; then
    item_ident=$(sni_id "$svc" "$path")
    matched=$([[ ${item_ident,,} == "${ident,,}" ]] && echo 1 || echo 0)
  else
    item_title=$(sni_title "$svc" "$path")
    matched=$([[ ${item_title,,} == "${title,,}" ]] && echo 1 || echo 0)
  fi
  if ((matched)); then
    match_service="$svc"
    match_path="$path"
    break
  fi
done <<<"$items"

[[ -n $match_service ]] || {
  echo "cornice-tray-activate: no tray item with id '$ident' title '$title'" >&2
  exit 1
}

menu=$(sni_menu "$match_service" "$match_path")
[[ -n $menu && $menu == /* ]] || { echo "cornice-tray-activate: '$title' has no menu" >&2; exit 1; }

gdbus call --session --dest "$match_service" --object-path "$menu" \
  --method com.canonical.dbusmenu.AboutToShow 0 >/dev/null 2>&1 || true

# Fetch every level. Parse GVariant containers (including variants and type
# annotations), then resolve occurrences within their parent, not globally.
layout_file=$(mktemp)
trap 'rm -f "$layout_file"' EXIT
gdbus call --session --dest "$match_service" --object-path "$menu" \
  --method com.canonical.dbusmenu.GetLayout -- 0 -1 "['label']" >"$layout_file" 2>/dev/null
item_id=$(python3 - "$layout_file" "$label" "$index" "$menu_path" <<'PYTHON'
import ast, json, re, sys
filename, label, occurrence, route = sys.argv[1:]
tokens = re.findall(r"'(?:\\.|[^'\\])*'|\"(?:\\.|[^\"\\])*\"|@[^\s]+|[A-Za-z_][A-Za-z_0-9]*|-?\d+|[^\s]", open(filename).read())
position = 0

def parse():
    global position
    token = tokens[position]
    position += 1
    if token.startswith('@') or token in ('uint32', 'int32', 'uint64', 'int64', 'byte', 'objectpath', 'signature'):
        return parse()
    if token == '<':
        value = parse()
        assert tokens[position] == '>'
        position += 1
        return value
    if token in ('(', '[', '{'):
        end = {'(': ')', '[': ']', '{': '}'}[token]
        result = {} if token == '{' else []
        while tokens[position] != end:
            value = parse()
            if token == '{':
                assert tokens[position] == ':'
                position += 1
                result[value] = parse()
            else:
                result.append(value)
            if tokens[position] == ',':
                position += 1
        position += 1
        return result
    if token in ('true', 'false'):
        return token == 'true'
    return ast.literal_eval(token)

_, tree = parse()
if route:
    for segment in json.loads(route):
        matches = [child for child in tree[2] if child[1].get("label", "") == segment["text"]]
        index = int(segment.get("index", 0))
        if index < 0 or index >= len(matches):
            sys.exit(1)
        tree = matches[index]
    print(tree[0])
else:
    def descend(node):
        for child in node[2]:
            yield child
            yield from descend(child)
    matches = [node for node in descend(tree)
               if node[1].get("label", "").strip().lower() == label.strip().lower()]
    if int(occurrence) < len(matches):
        print(matches[int(occurrence)][0])
PYTHON
)

if [[ -z $item_id ]]; then
  message="no entry labelled '$label' (occurrence $index) in the menu of $match_service"
  echo "cornice-tray-activate: $message" >&2
  logger -t cornice "tray activate failed: $message" 2>/dev/null || true
  exit 1
fi

if ((dry)); then
  echo "would activate id=$item_id label='$label' index=$index in $match_service"
  exit 0
fi

# DBusMenu's timestamp field is uint32, so a 13-digit millisecond value is
# rejected by gdbus *before* it is ever sent (the click silently did nothing).
# libdbusmenu wraps it the same way.
stamp=$(( $(date +%s%3N) % 4294967296 ))
# Keep stderr: gdbus reports payload problems there (an out-of-range timestamp
# made every click fail silently for a while).
event_error=$(timeout 15 gdbus call --session --dest "$match_service" --object-path "$menu" \
  --method com.canonical.dbusmenu.Event "$item_id" clicked "<''>" "$stamp" 2>&1 >/dev/null)
status=$?
if [[ $status == 124 ]]; then
  # Many apps (ChatGPT, fcitx5) act on the click without answering the method
  # call in time — the dialog/action appears anyway.
  logger -t cornice "tray activate: $match_service did not reply in time (id=$item_id); the action usually still happened" 2>/dev/null || true
  exit 0
fi
if [[ $status != 0 ]]; then
  message="the app rejected the click (exit $status${event_error:+: ${event_error%%$'\n'*}})"
  echo "cornice-tray-activate: $message" >&2
  logger -t cornice "tray activate: $match_service $message (id=$item_id)" 2>/dev/null || true
  exit $status
fi
exit $status
