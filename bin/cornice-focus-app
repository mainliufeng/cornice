#!/usr/bin/env bash
# cornice-focus-app — bring the app that sent a notification to the front.
#
# Clicking a notification should take you to the app. The freedesktop way is to
# invoke the notification's "default" action, but plenty of clients (Paseo, Grok
# Bot, satty) send no action at all — the only handle left is the D-Bus sender
# hint. Prefer the sender PID, then the desktop entry, then the app name.
#
#   cornice-focus-app --pid 3081948
#   cornice-focus-app --desktop paseo.desktop --name Paseo
#
# Exits 0 when a window was focused, 1 when nothing matched (the caller just
# dismisses the notification then).
set -euo pipefail

pid=""; desktop=""; name=""
while (($#)); do
  case "$1" in
    --pid) pid="${2:-}"; shift 2 ;;
    --desktop) desktop="${2:-}"; shift 2 ;;
    --name) name="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done

command -v hyprctl >/dev/null 2>&1 || exit 0
clients=$(hyprctl clients -j 2>/dev/null) || exit 0
[[ -n $clients ]] || exit 0

# A desktop entry is "org.example.App.desktop"; the window's class is usually
# the same stem, but the case is not guaranteed.
desktop_key=$(printf '%s' "$desktop" | sed 's/\.desktop$//' | tr '[:upper:]' '[:lower:]')
name_key=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')

# A native shortcut's explicit identity wins over inherited shell context.
seat="${CORNICE_DESKTOP_NAME:-}"
if [[ -n ${HYPRLAND_SEAT_ID:-} ]]; then
  seat="${HYPRLAND_SEAT_NAME:?Native seat name required}"
fi
workspace_scope=""
seat_id=""; generation=""
bin_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
if [[ -n $seat && $seat != main ]]; then
  [[ $seat =~ ^[a-zA-Z0-9_-]+$ ]] || exit 2
  actual=$("$bin_dir/cornice-desktop" state "$seat")
  jq -e '.available == true and (.controlMode == "human" or .controlMode == "agent")' <<<"$actual" >/dev/null || exit 1
  if [[ -n ${HYPRLAND_SEAT_ID:-} ]]; then
    jq -e --arg id "$HYPRLAND_SEAT_ID" --arg generation "${HYPRLAND_SEAT_GENERATION:-}" \
      '.seatId == $id and (.generation | tostring) == $generation' <<<"$actual" >/dev/null || exit 1
  fi
  seat_id=$(jq -er '.seatId' <<<"$actual")
  generation=$(jq -er '.generation | tostring' <<<"$actual")
  workspace_scope=$(jq -er '.workspaceName // .workspace | sub("^name:"; "")' <<<"$actual")
fi

target=$(jq -c --arg pid "$pid" --arg desktop "$desktop_key" --arg name "$name_key" --arg workspace "$workspace_scope" '
  def down: (. // "") | ascii_downcase;
  def in_workspace: $workspace == "" or ((.workspace.name // "") | sub("^name:"; "")) == $workspace;
  def class_matches($key): $key != "" and (((.class // "") | down) == $key or ((.initialClass // "") | down) == $key);
  [.[] | select(.mapped == true)] as $all
  | [$all[] | select($pid != "" and ((.pid // -1) | tostring) == $pid)] as $sender
  | [$all[] | select(in_workspace)] as $scoped
  | (if ($sender | length) > 0 then $sender | map(select(in_workspace))
     else [$scoped[] | select(class_matches($desktop))] end) as $preferred
  | (if ($sender | length) > 0 or ($preferred | length) > 0 then $preferred
     else [$scoped[] | select(class_matches($name))] end)
  | .[0] // empty
' <<<"$clients")

[[ -n $target ]] || exit 1
address=$(jq -er '.address' <<<"$target")
workspace=$(jq -er '.workspace.name' <<<"$target")

# Private Wayland displays do not scope hyprctl. Focus the exact desktop
# identity used by the launcher and let the compositor reject obsolete state.
if [[ -n $seat && $seat != main ]]; then
  exec "$bin_dir/cornice-desktop" view-focus "$seat" "$address" \
    --seat "$seat_id" "$generation" --workspace "$workspace_scope"
fi

# Switch to the window's workspace, then focus it. The two cursor/fullscreen
# options are restored in the same batch so a notification click never warps the
# pointer or drops a fullscreen window (same trick as cornice-focus-window).
warps=$(hyprctl -j getoption cursor:no_warps | jq -er 'if has("bool") then (if .bool then 1 else 0 end) else .int end')
under=$(hyprctl -j getoption misc:on_focus_under_fullscreen | jq -er '.int')
[[ $warps =~ ^[01]$ && $under =~ ^[012]$ ]] || exit 1

if hyprctl -j seat capabilities 2>/dev/null | jq -e '.dialect == "lua"' >/dev/null 2>&1; then
  bin_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
  exec "$bin_dir/cornice-compositor" focus-window "$address" "$warps" "$under" "$workspace"
fi

batch="keyword cursor:no_warps 1; keyword misc:on_focus_under_fullscreen 1"
if [[ -n $workspace && $(hyprctl activeworkspace -j | jq -r '.name') != "$workspace" ]]; then
  batch+="; dispatch workspace \"$workspace\""
fi
batch+="; dispatch focuswindow address:$address"
batch+="; keyword misc:on_focus_under_fullscreen $under; keyword cursor:no_warps $warps"

hyprctl --batch "$batch" >/dev/null
