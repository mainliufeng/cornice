#!/usr/bin/env bash
# Restart the Cornice shell.
#
# Kills every instance of this config path (not other Quickshell shells), then
# starts a fresh one. Spawns through Hyprland when possible so the new process
# inherits the session environment rather than a terminal's.
set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
bin_dir=$(dirname "$self")
prefix="${CORNICE_PATH:-$(cd "$bin_dir/.." && pwd)}"
export CORNICE_PATH="$prefix"
config_dir="$prefix/shell"
qs="$bin_dir/cornice-qs"

while "$qs" kill -p "$config_dir" --any-display >/dev/null 2>&1; do :; done

# Absolute path on purpose: the compositor's PATH does not necessarily contain
# ~/.local/bin, and a failed relaunch after killing the old shell leaves the user
# with no bar at all.
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null 2>&1; then
  hyprctl dispatch "exec $bin_dir/cornice-launch" >/dev/null 2>&1
  sleep 0.3
fi
if ! timeout 3 "$bin_dir/cornice" ping >/dev/null 2>&1; then
  setsid "$bin_dir/cornice-launch" >/dev/null 2>&1 &
  disown || true
fi

for _ in $(seq 1 50); do
  if timeout 5 "$qs" ipc -p "$config_dir" call shell ping >/dev/null 2>&1; then
    echo "cornice: shell restarted"
    exit 0
  fi
  sleep 0.1
done

echo "cornice: shell did not answer after 5s" >&2
exit 1
