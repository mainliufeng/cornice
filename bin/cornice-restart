#!/usr/bin/env bash
# Restart the Cornice shell.
#
# Kills every instance of this config path (not other Quickshell shells), then
# starts a fresh one. Spawns through Hyprland when possible so the new process
# inherits the session environment rather than a terminal's.
set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
bin_dir=$(dirname "$self")
prefix="${CORNICE_PATH:-$(cd "$bin_dir/.." && pwd)}"
export CORNICE_PATH="$prefix"
config_dir="$prefix/shell"
qs="$bin_dir/cornice-qs"

# Restarting while the session lock is secure would kill the only lock client
# and can strand the user behind the compositor's failsafe. Refuse, and tell
# them what to do instead.
if [[ -S ${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/cornice-${USER:-user}.sock ]]; then
  lock_state=$(timeout 3 "$bin_dir/cornice" ipc lock status 2>/dev/null | jq -r '.secure // false' 2>/dev/null || echo false)
  if [[ $lock_state == "true" ]]; then
    echo "cornice: refusing to restart while the session is locked." >&2
    echo "  unlock first, or from another TTY: cornice lock emergency-unlock" >&2
    exit 1
  fi
fi

# Kill every instance and wait for them to actually be gone: launching while an
# old instance is still alive makes the new one exit immediately (quickshell -n)
# and leaves the session with no shell at all.
while "$qs" kill -p "$config_dir" --any-display >/dev/null 2>&1; do :; done
for _ in $(seq 1 50); do
  "$qs" ipc -p "$config_dir" call shell ping >/dev/null 2>&1 || break
  sleep 0.1
done
# A socket left behind by a killed instance would make the CLI talk to nothing.
rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/cornice-${USER:-user}.sock" 2>/dev/null || true

# Absolute path on purpose: the compositor's PATH does not necessarily contain
# ~/.local/bin, and a failed relaunch after killing the old shell leaves the user
# with no bar at all.
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null 2>&1; then
  hyprctl dispatch "exec $bin_dir/cornice-launch" >/dev/null 2>&1
  sleep 0.3
fi
# Wait longer than a shell needs to boot before assuming the dispatch failed;
# a premature fallback is what produced duplicate instances (and with them a
# shell that could not own org.freedesktop.Notifications).
if ! timeout 15 "$bin_dir/cornice" ping >/dev/null 2>&1; then
  if pgrep -x quickshell >/dev/null 2>&1; then
    echo "cornice: a shell process exists but is not answering yet" >&2
  else
    setsid "$bin_dir/cornice-launch" >/dev/null 2>&1 &
    disown || true
  fi
fi

# Two attempts: the first launch can still lose the race against a dying
# instance, and a retry is cheaper than a session without a shell.
for attempt in 1 2; do
  for _ in $(seq 1 60); do
    if timeout 3 "$qs" ipc -p "$config_dir" call shell ping >/dev/null 2>&1; then
      echo "cornice: shell restarted"
      exit 0
    fi
    sleep 0.15
  done
  [[ $attempt == 1 ]] && setsid "$bin_dir/cornice-launch" >/dev/null 2>&1 &
done

echo "cornice: shell did not answer after two launch attempts" >&2
exit 1
