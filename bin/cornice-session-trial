#!/usr/bin/python3
"""Select an immutable SDDM/Hyprland session; stable installed versions stay intact."""
import argparse
import ctypes
import fcntl
import hashlib
import json
import os
import re
from pathlib import Path
import shlex
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
import uuid


ROOT = Path(__file__).resolve().parent.parent
if (Path(__file__).resolve().parent / "cornice/bin/cornice").is_file():
    ROOT = Path(__file__).resolve().parent / "cornice"
STATE = Path(os.environ.get("CORNICE_TRIAL_STATE_DIR",
    str(Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "cornice/session-trial")))
SELECTION_SCHEMA = 1
HOOK_BEGIN = "# BEGIN cornice one-shot session trial"
HOOK_END = "# END cornice one-shot session trial"


def atomic(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_name(path.name + "." + uuid.uuid4().hex + ".tmp")
    try:
        with temporary.open("x") as stream:
            temporary.chmod(0o600)
            stream.write(value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, indent=2) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(path)
        descriptor = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    finally:
        temporary.unlink(missing_ok=True)


def read(path):
    return json.loads(Path(path).read_text())


def digest(path):
    with Path(path).open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def run(args, env=None, timeout=4):
    result = subprocess.run(list(map(str, args)), env=env, capture_output=True, text=True, timeout=timeout)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or f"Command failed: {args[0]}")
    return result.stdout.strip()


def locked():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    stream = (STATE / "control.lock").open("a")
    fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
    return stream


def cancel_ticket():
    (STATE / "pending.json").unlink(missing_ok=True)
    descriptor = os.open(STATE, os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def remove_block(contents):
    if HOOK_BEGIN not in contents:
        return contents
    start = contents.index("\n" + HOOK_BEGIN) if "\n" + HOOK_BEGIN in contents else contents.index(HOOK_BEGIN)
    end = contents.index(HOOK_END, start) + len(HOOK_END)
    if contents[end:end + 1] == "\n":
        end += 1
    return contents[:start] + contents[end:]


def native_layout_bindings(configuration):
    # These generated bindings still called a stable Hyprland helper. Replace
    # only its literal layout messages, without parsing arbitrary shell code.
    helpers = ("~/.config/hypr/scripts/layoutmsg-active.sh", str(Path.home() / ".config/hypr/scripts/layoutmsg-active.sh"))
    number = r"[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)"
    messages = re.compile(r"(?:addmaster|removemaster|mfact (?:exact )?" + number + r"|splitratio " + number + r"(?: exact)?)")

    def replace(match):
        try:
            command = json.loads(match[1])
        except ValueError:
            return match[0]
        for helper in helpers:
            prefix = helper + " "
            if not command.startswith(prefix):
                continue
            message = command[len(prefix):]
            if messages.fullmatch(message):
                return "hl.dsp.layout(" + json.dumps(message) + ")"
        return match[0]

    return re.sub(r'\bhl\.dsp\.exec_cmd\(\s*("(?:[^"\\]|\\.)*")\s*\)', replace, configuration)


def native_screenshot_bindings(configuration, product):
    pipelines = {'grim -g "$(slurp)" - | satty --filename -': 'region', 'grim - | satty --filename -': 'screen'}
    command = [str(product / "bin/cornice"), "screenshot"]
    def replace(match):
        try:
            previous = json.loads(match[1])
        except ValueError:
            return match[0]
        return "hl.dsp.exec_cmd(" + json.dumps(shlex.join(command + [pipelines[previous]])) + ")" if previous in pipelines else match[0]
    return re.sub(r'\bhl\.dsp\.exec_cmd\(\s*("(?:[^"\\]|\\.)*")\s*\)', replace, configuration)


UI_PLATFORM = "cornice/native/qml/Cornice/Platform/"


def ui_platform_id(product):
    module = Path(product) / "native/qml/Cornice/Platform"
    hashes = {str(path.relative_to(module)): digest(path) for path in module.rglob("*") if path.is_file()}
    if not hashes:
        return "absent"
    return hashlib.sha256(json.dumps(hashes, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def ui_build(shell, identifier):
    """Stamp copied QML before hashing, without editing the source tree."""
    atomic(Path(shell) / "Commons/UiBuild.qml", "pragma Singleton\nimport QtQml\n\n"
           "// Immutable UI generation created by session-trial prepare.\n"
           "QtObject { readonly property string id: " + json.dumps(identifier) +
           "; readonly property string platformId: " + json.dumps(ui_platform_id(Path(shell).parent)) + " }\n")


def ui_identity(path):
    value = Path(path).lstat()
    return [value.st_dev, value.st_ino]


def ui_exchange(left, right):
    rename = getattr(ctypes.CDLL(None, use_errno=True), "renameat2", None)
    if rename is None:
        raise RuntimeError("UI update requires Linux renameat2; current UI unchanged")
    rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    rename.restype = ctypes.c_int
    if rename(-100, os.fsencode(left), -100, os.fsencode(right), 2):
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    for parent in {Path(left).parent, Path(right).parent}:
        descriptor = os.open(parent, os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)


def ui_release(value):
    path = Path(value).resolve()
    if path.parent != (STATE / "releases").resolve():
        raise RuntimeError("UI update accepts only prepared releases in this state directory")
    return path


def ui_hashes(release, manifest, prefix):
    hashes = {key: value for key, value in manifest["hashes"].items() if key.startswith(prefix)}
    actual = {str(path.relative_to(release)): digest(path)
              for path in (release / prefix.rstrip("/")).rglob("*") if path.is_file()}
    # A Platform overlay is a symlink under native/qml. pathlib's recursive
    # glob does not descend directory symlinks; enumerate this approved root
    # directly so future upgrades verify every currently active module file.
    if prefix == "cornice/native/" and (release / UI_PLATFORM.rstrip("/")).is_symlink():
        actual.update(ui_hashes(release, manifest, UI_PLATFORM))
    if not hashes or hashes != actual:
        raise RuntimeError("UI update payload differs from the manifest: " + prefix)
    return hashes


def ui_compatible(current, current_manifest, candidate, candidate_manifest):
    # The UI consists of shell QML and its Cornice.Platform module. All other
    # native code and helpers belong to the running session and stay unchanged.
    for relative in ("Hyprland", "cornice/bin/cornice-desktopd", "cornice/bin/cornice-desktop",
                     "cornice/config/session-services.json"):
        if (relative not in current_manifest["hashes"] or relative not in candidate_manifest["hashes"] or
                current_manifest["hashes"][relative] != candidate_manifest["hashes"][relative]):
            raise RuntimeError("UI-only update is incompatible: " + relative)
    for prefix in ("cornice/native/", "cornice/bin/"):
        old = ui_hashes(current, current_manifest, prefix)
        new = ui_hashes(candidate, candidate_manifest, prefix)
        if prefix == "cornice/native/":
            old = {key: value for key, value in old.items() if not key.startswith(UI_PLATFORM)}
            new = {key: value for key, value in new.items() if not key.startswith(UI_PLATFORM)}
        if prefix == "cornice/bin/":
            for helper in ("cornice", "cornice-session-trial"):
                old.pop(prefix + helper, None)
                new.pop(prefix + helper, None)
        if old != new:
            raise RuntimeError("UI-only update is incompatible: " + prefix)
    return ui_hashes(candidate, candidate_manifest, "cornice/shell/")


def ui_environment(pid, keys):
    values = {}
    for entry in (Path("/proc") / str(pid) / "environ").read_bytes().split(b"\0"):
        if b"=" not in entry:
            continue
        key, value = entry.split(b"=", 1)
        key = key.decode()
        if key in keys:
            values[key] = value.decode()
    return values


def ui_peer_matches(pid, name, context):
    keys = {"CORNICE_PATH", "HYPRLAND_INSTANCE_SIGNATURE", "CORNICE_DESKTOP_NAME"}
    values = ui_environment(pid, keys)
    return (Path(values.get("CORNICE_PATH", "")).resolve() == context["release"] / "cornice" and
            values.get("HYPRLAND_INSTANCE_SIGNATURE") == context["environment"]["HYPRLAND_INSTANCE_SIGNATURE"] and
            values.get("CORNICE_DESKTOP_NAME", "") == name)


def ui_context(info, allow_dead_shell=False):
    if not is_running(info) or info.get("status") not in ("ready", "confirmed"):
        raise RuntimeError("UI update requires a running healthy trial")
    release = ui_release(info["release"])
    environment = os.environ.copy()
    for key in list(environment):
        if key.startswith(("CORNICE_", "HYPRLAND_SEAT_", "HYPRLAND_ACTION_")):
            environment.pop(key)
    known = {"XDG_RUNTIME_DIR", "USER", "HOME", "DBUS_SESSION_BUS_ADDRESS", "WAYLAND_DISPLAY",
             "HYPRLAND_INSTANCE_SIGNATURE", "CORNICE_SHELL_SOCKET", "CORNICE_PRIMARY_SHELL_SOCKET"}
    for component in ("compositorPid", "brokerPid", "shellPid"):
        pid = info.get(component)
        if type(pid) is not int or pid <= 0 or not start_identity(pid):
            if component == "shellPid" and allow_dead_shell:
                continue  # File rollback must remain possible after a failed UI startup.
            raise RuntimeError("UI update cannot verify current component: " + component)
        proc = Path("/proc") / str(pid)
        if proc.stat().st_uid != os.getuid():
            raise RuntimeError("UI update component belongs to another user")
        values = ui_environment(pid, known | {"CORNICE_PATH"})
        if component != "compositorPid" and Path(values.get("CORNICE_PATH", "")).resolve() != release / "cornice":
            raise RuntimeError("UI update component runs another product: " + component)
        if component == "shellPid" or (allow_dead_shell and component == "brokerPid"):
            environment.update({key: values[key] for key in known if key in values})
    if digest(Path("/proc") / str(info["compositorPid"]) / "exe") != digest(release / "Hyprland"):
        raise RuntimeError("Running compositor differs from the current release")
    if (environment.get("HYPRLAND_INSTANCE_SIGNATURE") != info.get("instance") or
            environment.get("WAYLAND_DISPLAY") != info.get("display") or
            not Path(environment.get("XDG_RUNTIME_DIR", "")).is_absolute()):
        raise RuntimeError("UI update cannot identify the current compositor environment")
    environment.update(CORNICE_PATH=str(release / "cornice"), XDG_CONFIG_HOME=str(release / "config-home"),
                       CORNICE_TRIAL_STATE_DIR=str(STATE))
    primary = environment.get("CORNICE_PRIMARY_SHELL_SOCKET") or environment.get("CORNICE_SHELL_SOCKET")
    if not primary:
        primary = str(Path(environment["XDG_RUNTIME_DIR"]) / ("cornice-" + environment["USER"] + ".sock"))
    environment.update(CORNICE_SHELL_SOCKET=primary, CORNICE_PRIMARY_SHELL_SOCKET=primary)
    return {"release": release, "environment": environment, "info": info}


def ui_cli(cli, context, name, *arguments):
    environment = context["environment"].copy()
    if name:
        environment["CORNICE_DESKTOP_NAME"] = name
    else:
        environment.pop("CORNICE_DESKTOP_NAME", None)
    return run([cli, *arguments], env=environment, timeout=12)


def ui_desktops(cli, context, cold=False):
    value = json.loads(ui_cli(cli, context, "", "desktop", "list"))
    desktops = value.get("desktops")
    if (not isinstance(desktops, list) or not desktops or
            not all(isinstance(item, dict) and re.fullmatch(r"[A-Za-z0-9_-]+", item.get("name", ""))
                    for item in desktops) or len({item["name"] for item in desktops}) != len(desktops) or
            sum(item.get("primary") is True for item in desktops) != 1):
        raise RuntimeError("UI update cannot verify the managed desktop list")
    for item in desktops:
        if ((item.get("presentation") or {}).get("active") is not False or item.get("humanTakeover") is True or
                item.get("humanLocked") is True or (item.get("handoff") or {}).get("status") == "in_progress"):
            raise RuntimeError("UI update refused during desktop presentation, takeover or lock")
        if cold and (item.get("occupied") is not False or item.get("paused") is not True):
            raise RuntimeError("Cold UI maintenance requires every desktop to be unoccupied and paused")
    return desktops


def ui_runtime(cli, context, name):
    return json.loads(ui_cli(cli, context, name, "ipc", "shell", "runtimeIdentity"))


def ui_socket_peer(context, name):
    runtime = Path(context["environment"]["XDG_RUNTIME_DIR"])
    signature = context["environment"]["HYPRLAND_INSTANCE_SIGNATURE"]
    digest8 = hashlib.sha256(signature.encode()).hexdigest()[:8]
    path = Path(context["environment"]["CORNICE_SHELL_SOCKET"]) if not name else runtime / ("cs-" + digest8 + "-" + name + ".sock")
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(2)
        connection.connect(str(path))
        import struct
        pid, uid, _ = struct.unpack("3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
    if (uid != os.getuid() or not start_identity(pid) or not ui_peer_matches(pid, name, context) or
            (not name and pid != context["info"]["shellPid"])):
        raise RuntimeError("UI update shell socket identity differs from current session")
    parent = int((Path("/proc") / str(pid) / "stat").read_text().rsplit(")", 1)[1].split()[1])
    expected_parent = context["info"]["brokerPid"] if name else context["info"]["pid"]
    if parent != expected_parent:
        raise RuntimeError("UI shell socket peer is not owned by the current supervisor/Broker")
    return {"name": name, "pid": pid, "processStart": start_identity(pid)}


def ui_shells(cli, context):
    result = []
    signature = context["environment"]["HYPRLAND_INSTANCE_SIGNATURE"]
    for desktop in ui_desktops(cli, context):
        name = "" if desktop.get("primary") else desktop["name"]
        peer = ui_socket_peer(context, name)
        pid = peer["pid"]
        before = None
        try:
            before = ui_runtime(cli, context, name)
        except RuntimeError as error:
            if "unknown method: shell.runtimeIdentity" not in str(error):
                raise
            # First bootstrap supports the old shell without this read-only method.
        if before and (before.get("pid") != pid or before.get("instance") != signature or
                       before.get("desktop") != (name or "main")):
            raise RuntimeError("UI update runtime identity belongs to another shell")
        if not ui_cli(cli, context, name, "ping").startswith("pong"):
            raise RuntimeError("UI update shell failed its health check")
        result.append({"name": name, "pid": pid, "processStart": start_identity(pid),
                       "output": desktop["output"],
                       "beforeBuild": before.get("uiBuildId") if before else None,
                       "beforePlatform": before.get("platformBuildId") if before else None,
                       "beforeTransport": before.get("ipcTransport") if before else None})
    return result


def ui_bar_mapped(context, shell):
    if not shell.get("output"):
        return True  # Old recovery journals predate this readback contract.
    layers = ipc(context["environment"], "layers")
    return any(layer.get("namespace") == "cornice-bar" and layer.get("pid") == shell["pid"]
               for level in layers.get(shell["output"], {}).get("levels", {}).values() for layer in level)


def ui_wait(cli, context, shell, expected, timeout=8, platform=None):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if start_identity(shell["pid"]) != shell["processStart"]:
            raise RuntimeError("UI reload replaced or lost a shell process")
        try:
            if expected is None:
                try:
                    ui_runtime(cli, context, shell["name"])
                except RuntimeError as error:
                    if ("unknown method: shell.runtimeIdentity" in str(error) and
                            ui_cli(cli, context, shell["name"], "ping").startswith("pong") and ui_bar_mapped(context, shell)):
                        return
            else:
                value = ui_runtime(cli, context, shell["name"])
                if (value.get("uiBuildId") == expected and value.get("pid") == shell["pid"] and
                        value.get("desktop") == (shell["name"] or "main") and
                        value.get("instance") == context["environment"]["HYPRLAND_INSTANCE_SIGNATURE"] and
                        (platform is None or value.get("platformBuildId") == platform) and ui_bar_mapped(context, shell)):
                    return
        except (RuntimeError, ValueError, subprocess.SubprocessError):
            pass
        time.sleep(.1)
    raise RuntimeError("UI build readback timed out for " + (shell["name"] or "main"))


def ui_record(value):
    directory = Path(value).resolve()
    if directory.parent != (STATE / "ui-overlays").resolve():
        raise RuntimeError("Invalid UI overlay record path")
    record = read(directory / "record.json")
    release = ui_release(record["currentRelease"])
    slot = Path(record["slot"])
    if slot.parent != release / "cornice" or slot.name != ".shell-ui-" + directory.name:
        raise RuntimeError("Invalid UI overlay rollback slot")
    platform = record.get("platform")
    if platform:
        platform_slot = Path(platform["slot"])
        if (platform_slot.parent != release / "cornice" or platform_slot.name != ".Platform-ui-" + directory.name or
                Path(platform["path"]) != release / UI_PLATFORM.rstrip("/")):
            raise RuntimeError("Invalid UI platform rollback slot")
    return directory, record, release, slot




def ui_preflight(candidate, context):
    """Parse every QML file and compile the real native IPC type privately.

    PanelWindow needs a Wayland backend, so this deliberately proves grammar
    and transport-module compatibility, not a successful complete visual start.
    The latter is checked after each owner-managed UI replacement.
    """
    files = sorted((candidate / "cornice/shell").rglob("*.qml"))
    parser = ("/usr/lib/qt6/bin/qmllint" if Path("/usr/lib/qt6/bin/qmllint").is_file()
              else shutil.which("qmllint6") or shutil.which("qmllint"))
    if not parser or not files or not re.search(r"qmllint 6\.", run([parser, "--version"])):
        raise RuntimeError("UI preflight requires Qt 6 qmllint and a prepared QML tree")
    # These are syntax diagnostics only. qs imports are supplied by Quickshell;
    # lint-only import/type warnings cannot prove a running visual shell works.
    result = subprocess.run([parser, "--ignore-settings", "--bare", "--json", "-", *map(str, files)], capture_output=True, text=True, timeout=20)
    try:
        parsed = json.loads(result.stdout)["files"]
        if {item["filename"] for item in parsed} != set(map(str, files)):
            raise ValueError("incomplete QML parser coverage")
        failures = [str(Path(item["filename"]).relative_to(candidate)) + ":" + str(warning.get("line", "")) +
                    ": " + warning["message"] for item in parsed for warning in item.get("warnings", [])
                    if warning.get("id") == "syntax"]
    except (KeyError, TypeError, ValueError) as error:
        raise RuntimeError("UI preflight could not verify Qt syntax diagnostics") from error
    if failures:
        raise RuntimeError("UI QML preflight rejected the candidate: " + "; ".join(failures)[:2000])
    with tempfile.TemporaryDirectory(prefix="cornice-ui-preflight-", dir="/tmp") as temporary:
        private = Path(temporary)
        shutil.copytree(candidate / "cornice/shell", private / "shell")
        for name in ("runtime", "home", "config", "cache", "data", "state"):
            (private / name).mkdir(mode=0o700)
        # Compile only: creating the candidate root would register its session
        # services. Its actual transport dependencies use no window backend.
        (private / "shell/preflight.qml").write_text(
            'import QtQuick\nimport Quickshell\nimport Cornice.Desktop\nShellRoot {\n'
            '  function compileTransport() {\n'
            '    const path = "file://" + Quickshell.env("CORNICE_PREFLIGHT_ROOT") + "/services/IpcServer.qml"\n'
            '    const component = Qt.createComponent(path, Component.PreferSynchronous)\n'
            '    if (component.status !== Component.Ready) {\n'
            '      console.error("CORNICE_PREFLIGHT_ERROR " + component.errorString()); Qt.exit(1); return\n'
            '    }\n'
            '    component.destroy(); console.log("CORNICE_PREFLIGHT_OK"); Qt.quit()\n'
            '  }\n  Component.onCompleted: Qt.callLater(compileTransport)\n}\n')
        excluded = {"DISPLAY", "WAYLAND_DISPLAY", "WAYLAND_SOCKET", "DBUS_SESSION_BUS_ADDRESS",
                    "DBUS_SYSTEM_BUS_ADDRESS", "QML_IMPORT_PATH", "QT_PLUGIN_PATH"}
        environment = {key: value for key, value in os.environ.items()
                       if key not in excluded and not key.startswith(("CORNICE_", "HYPRLAND_", "QS_", "QT_", "XDG_"))}
        environment.update(HOME=str(private / "home"), QT_QPA_PLATFORM="offscreen", QSG_RHI_BACKEND="software",
            XDG_RUNTIME_DIR=str(private / "runtime"), XDG_CONFIG_HOME=str(private / "config"),
            XDG_CACHE_HOME=str(private / "cache"), XDG_DATA_HOME=str(private / "data"), XDG_STATE_HOME=str(private / "state"),
            DBUS_SESSION_BUS_ADDRESS="unix:path=" + str(private / "no-session-bus"),
            DBUS_SYSTEM_BUS_ADDRESS="unix:path=" + str(private / "no-system-bus"),
            QML_IMPORT_PATH=str(candidate / "cornice/native/qml"), CORNICE_PREFLIGHT_ROOT=str(private / "shell"),
            QS_DISABLE_FILE_WATCHER="1", QS_NO_RELOAD_POPUP="1")
        executable = (Path("/proc") / str(context["info"]["shellPid"]) / "exe").resolve(strict=True)
        result = subprocess.run([str(executable), "--no-color", "-p", str(private / "shell/preflight.qml")],
                                env=environment, capture_output=True, text=True, timeout=10)
        output = result.stdout + result.stderr
        if result.returncode or "CORNICE_PREFLIGHT_OK" not in output:
            raise RuntimeError("UI native module preflight rejected the candidate: " + output.strip()[-2000:])

def ui_native_identity(context):
    return {key: {"pid": context["info"][key], "processStart": start_identity(context["info"][key])}
            for key in ("pid", "compositorPid", "brokerPid")}


def ui_native_unchanged(context, expected):
    info = read(STATE / "current.json")
    if info.get("release") != str(context["release"]):
        raise RuntimeError("UI maintenance session release changed")
    for key, proof in expected.items():
        if info.get(key) != proof["pid"] or start_identity(proof["pid"]) != proof["processStart"]:
            raise RuntimeError("UI maintenance changed a native session process: " + key)
    return info


def ui_stop_shell(context, shell):
    """Stop one authenticated owner-tracked UI process, never its process group."""
    peer = ui_socket_peer(context, shell["name"])
    if any(peer[key] != shell[key] for key in ("name", "pid", "processStart")):
        raise RuntimeError("UI shell identity changed before controlled replacement")
    if not hasattr(os, "pidfd_open") or not hasattr(signal, "pidfd_send_signal"):
        raise RuntimeError("Cold UI maintenance requires Linux pidfd signaling")
    descriptor = os.pidfd_open(shell["pid"])
    try:
        if start_identity(shell["pid"]) != shell["processStart"]:
            raise RuntimeError("UI shell process was replaced before signaling")
        signal.pidfd_send_signal(descriptor, signal.SIGTERM)
    finally:
        os.close(descriptor)


def ui_replacement(cli, context, shell, expected, native, platform=None, timeout=35, fail_exited=False):
    deadline = time.monotonic() + timeout
    last = "owner has not restarted the shell"
    while time.monotonic() < deadline:
        info = ui_native_unchanged(context, native)
        fresh = dict(context, info=info)
        if (fail_exited and not shell["name"] and info.get("shellPid") != shell["pid"] and
                not start_identity(info.get("shellPid", 0))):
            raise RuntimeError("The supervisor-started UI exited before its build became readable")
        try:
            peer = ui_socket_peer(fresh, shell["name"])
            if shell.get("output"):
                peer["output"] = shell["output"]
            if peer["pid"] == shell["pid"] and peer["processStart"] == shell["processStart"]:
                raise RuntimeError("UI owner still serves the previous process")
            ui_wait(cli, fresh, peer, expected, timeout=.3, platform=platform)
            return peer
        except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
            last = str(error)
        time.sleep(.1)
    raise RuntimeError("UI replacement readback timed out for " + (shell["name"] or "main") + ": " + last)


def ui_paths_restore(current, record):
    paths = [{"path": str(current / "cornice/shell"), "slot": record["slot"],
              "originalIdentity": record["originalIdentity"], "newIdentity": record["newIdentity"]}]
    if record.get("platform"):
        paths.append(record["platform"])
    # Verify both sides before touching either directory. A journal persisted
    # before exchange makes interruption between the two renames recoverable.
    for item in paths:
        identity = ui_identity(item["path"])
        if identity not in (item["originalIdentity"], item["newIdentity"]):
            raise RuntimeError("UI payload changed independently; rollback refused")
        opposite = item["newIdentity"] if identity == item["originalIdentity"] else item["originalIdentity"]
        if ui_identity(item["slot"]) != opposite:
            raise RuntimeError("Saved UI payload changed independently; rollback refused")
    for item in paths:
        if ui_identity(item["path"]) == item["newIdentity"]:
            ui_exchange(item["path"], item["slot"])


def ui_restore_cold(directory, record, context):
    current = ui_release(record["currentRelease"])
    original = (directory / "original-manifest.json").read_text()
    new = (directory / "new-manifest.json").read_text()
    if (current / "manifest.json").read_text() not in (original, new):
        raise RuntimeError("Current manifest changed independently; refusing to overwrite it")
    cli = ui_release(record["sourceRelease"]) / "cornice/bin/cornice"
    if digest(cli) != record["cliHash"]:
        raise RuntimeError("Saved UI maintenance CLI changed; rollback execution refused")
    record["phase"] = "rollback-pending"
    atomic(directory / "record.json", record)
    atomic(STATE / "ui-overlay.json", {"record": str(directory)})
    ui_paths_restore(current, record)
    atomic(current / "manifest.json", original)
    errors, pending, replacements = {}, [], list(record.get("replacements", []))
    if context:
        native = record["nativeIdentity"]
        info = ui_native_unchanged(context, native)
        context = dict(context, info=info)
        try:
            ui_desktops(cli, context, cold=True)
        except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
            errors = {shell["name"]: str(error) for shell in record["shells"]}
        for shell in record["shells"]:
            name = shell["name"]
            if name in errors:
                pending.append(name)
                continue
            try:
                peer = ui_socket_peer(context, name)
                if shell.get("output"):
                    peer["output"] = shell["output"]
                try:
                    ui_wait(cli, context, peer, shell["beforeBuild"], timeout=.3, platform=shell.get("beforePlatform"))
                except (OSError, RuntimeError, ValueError, subprocess.SubprocessError):
                    # It still has the candidate loaded. Replace only this
                    # freshly authenticated UI; its owner starts restored files.
                    ui_stop_shell(context, peer)
                    peer = ui_replacement(cli, context, peer, shell["beforeBuild"], native,
                                          platform=shell.get("beforePlatform"))
                if peer["pid"] != shell["pid"] or peer["processStart"] != shell["processStart"]:
                    replacements.append({"desktop": name or "main", "previousPid": shell["pid"],
                                         "pid": peer["pid"], "processStart": peer["processStart"],
                                         "restoredBuild": shell["beforeBuild"], "verifiedAt": time.time()})
            except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
                # A process can already be gone while its owner is restarting.
                try:
                    peer = ui_replacement(cli, context, shell, shell["beforeBuild"], native,
                                          platform=shell.get("beforePlatform"))
                    replacements.append({"desktop": name or "main", "previousPid": shell["pid"],
                                         "pid": peer["pid"], "processStart": peer["processStart"],
                                         "restoredBuild": shell["beforeBuild"], "verifiedAt": time.time()})
                except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as replacement_error:
                    pending.append(name)
                    errors[name] = str(replacement_error)
    messages = [(name or "main") + ": " + error for name, error in errors.items()]
    record.update(phase="rollback-pending" if pending else ("restored-with-replacement" if replacements else "rolled-back"),
                  rollbackPending=pending, rollbackAttemptAt=time.time(), reloadErrors=messages, replacements=replacements)
    atomic(directory / "record.json", record)
    if not pending:
        previous = json.loads(original).get("uiOverlay")
        atomic(STATE / "ui-overlay.json", {"record": previous["record"]} if previous else {"record": None})
    return messages

def ui_restore(directory, record, context=None):
    if record.get("strategy") == "cold":
        return ui_restore_cold(directory, record, context)
    current = ui_release(record["currentRelease"])
    shell_path, slot = current / "cornice/shell", Path(record["slot"])
    original = (directory / "original-manifest.json").read_text()
    new = (directory / "new-manifest.json").read_text()
    if (current / "manifest.json").read_text() not in (original, new):
        raise RuntimeError("Current manifest changed independently; refusing to overwrite it")
    identity = ui_identity(shell_path)
    if identity not in (record["originalIdentity"], record["newIdentity"]):
        raise RuntimeError("Current UI directory changed independently; rollback refused")
    source = ui_release(record["sourceRelease"])
    cli = source / "cornice/bin/cornice"
    if digest(cli) != record["cliHash"]:
        raise RuntimeError("Saved UI maintenance CLI changed; rollback execution refused")
    record["phase"] = "rollback-pending"
    atomic(directory / "record.json", record)
    atomic(STATE / "ui-overlay.json", {"record": str(directory)})
    pending, prepared, errors, lost = [], [], {}, []
    replacements = list(record.get("replacements", []))
    if context:
        # A request with an uncertain reply may already have finished. Check the
        # compiled generation before issuing another explicit rollback attempt.
        for shell in record["shells"]:
            if start_identity(shell["pid"]) != shell["processStart"]:
                # A supervisor recovery is not a successful same-PID reload.
                # Reconcile only by observing a different authenticated current
                # peer already running the original UI; never reload it here.
                try:
                    if identity != record["originalIdentity"]:
                        raise RuntimeError("Replaced shell requires the original UI files before reconciliation")
                    verify_release(current)
                    peer = ui_socket_peer(context, shell["name"])
                    if shell.get("output"):
                        peer["output"] = shell["output"]
                    ui_wait(cli, context, peer, shell["beforeBuild"], timeout=.2)
                    proof = {"desktop": shell["name"] or "main", "previousPid": shell["pid"],
                             "pid": peer["pid"], "processStart": peer["processStart"],
                             "restoredBuild": shell["beforeBuild"], "verifiedAt": time.time()}
                    if not any(item["desktop"] == proof["desktop"] and item["pid"] == proof["pid"] for item in replacements):
                        replacements.append(proof)
                except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
                    lost.append(shell["name"])
                    errors[shell["name"]] = "Replaced shell restoration is not verified: " + str(error)
                continue
            try:
                ui_wait(cli, context, shell, shell["beforeBuild"], timeout=.2)
            except (OSError, RuntimeError, ValueError, subprocess.SubprocessError):
                pending.append(shell)
    if pending:
        try:
            ui_desktops(cli, context)
            # An earlier interrupted rollback can already have restored legacy
            # files that lack this controller. Briefly publish the saved new
            # files to prepare it, without reloading any QML generation yet.
            if identity == record["originalIdentity"]:
                if ui_identity(slot) != record["newIdentity"]:
                    raise RuntimeError("Saved new UI directory changed; rollback repair refused")
                ui_exchange(shell_path, slot)
                identity = record["newIdentity"]
                atomic(current / "manifest.json", new)
            for shell in pending:
                try:
                    ui_cli(cli, context, shell["name"], "reload-ui", "--prepare", "--bootstrap")
                    prepared.append(shell)
                except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                    errors[shell["name"]] = str(error)
        except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
            errors.update({shell["name"]: str(error) for shell in pending})
    if identity == record["newIdentity"]:
        if ui_identity(slot) != record["originalIdentity"]:
            raise RuntimeError("Saved UI directory changed independently; rollback refused")
        ui_exchange(shell_path, slot)
    atomic(current / "manifest.json", original)
    for shell in prepared:
        try:
            ui_cli(cli, context, shell["name"], "ipc", "shell", "call", "cn.runtime-control", "reload", "{}")
        except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
            errors[shell["name"]] = str(error)
    unresolved = list(lost)
    for shell in pending:
        try:
            ui_wait(cli, context, shell, shell["beforeBuild"])
            errors.pop(shell["name"], None)
        except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
            unresolved.append(shell["name"])
            errors.setdefault(shell["name"], str(error))
    messages = [(name or "main") + ": " + message for name, message in errors.items()]
    terminal = "restored-with-replacement" if replacements else "rolled-back"
    record.update(phase="rollback-pending" if unresolved else terminal, rollbackPending=unresolved,
                  rollbackAttemptAt=time.time(), reloadErrors=messages, replacements=replacements)
    atomic(directory / "record.json", record)
    if not unresolved:
        previous = json.loads(original).get("uiOverlay")
        atomic(STATE / "ui-overlay.json", {"record": previous["record"]} if previous else {"record": None})
    return messages

def update_ui(args):
    with locked():
        current_info = read(STATE / "current.json")
        context = ui_context(current_info)
        current = context["release"]
        candidate = ui_release(args.release)
        if candidate == current:
            raise RuntimeError("UI update requires a separate immutable candidate")
        current_manifest, candidate_manifest = verify_release(current), verify_release(candidate)
        hashes = ui_compatible(current, current_manifest, candidate, candidate_manifest)
        strategy = getattr(args, "strategy", "soft")
        old_platform = {key: value for key, value in current_manifest["hashes"].items() if key.startswith(UI_PLATFORM)}
        new_platform = {key: value for key, value in candidate_manifest["hashes"].items() if key.startswith(UI_PLATFORM)}
        platform_changed = old_platform != new_platform
        if platform_changed and strategy != "cold":
            raise RuntimeError("Cornice.Platform changed; explicit --strategy cold is required")
        stamp = (candidate / "cornice/shell/Commons/UiBuild.qml").read_text()
        if ("id: " + json.dumps(candidate_manifest["id"]) not in stamp or
                "platformId: " + json.dumps(ui_platform_id(candidate / "cornice")) not in stamp):
            raise RuntimeError("Candidate UI does not contain its prepared build and platform identities")
        cli = candidate / "cornice/bin/cornice"
        if strategy == "cold":
            ui_desktops(cli, context, cold=True)
            ui_preflight(candidate, context)
        shells = ui_shells(cli, context)
        if strategy == "soft" and any(shell.get("beforeTransport") != "qt-local-v1" for shell in shells):
            raise RuntimeError("Legacy UI transport requires explicit --strategy cold migration")
        native = ui_native_identity(context)
        active = STATE / "ui-overlay.json"
        if active.exists() and read(active).get("record"):
            _, previous, _, _ = ui_record(read(active)["record"])
            if previous["phase"] not in ("applied", "rolled-back", "restored-with-replacement"):
                raise RuntimeError("An interrupted UI update needs rollback-ui before another update")
        identifier = uuid.uuid4().hex
        directory = STATE / "ui-overlays" / identifier
        directory.mkdir(parents=True, mode=0o700)
        original = (current / "manifest.json").read_text()
        atomic(directory / "original-manifest.json", original)
        slot = current / "cornice" / (".shell-ui-" + identifier)
        slot.symlink_to(candidate / "cornice/shell", target_is_directory=True)
        record = {"schema": 1, "phase": "prepared", "currentRelease": str(current), "sourceRelease": str(candidate),
                  "uiBuildId": candidate_manifest["id"], "slot": str(slot), "shells": shells,
                  "strategy": strategy, "nativeIdentity": native,
                  "cliHash": digest(cli),
                  "originalIdentity": ui_identity(current / "cornice/shell"), "newIdentity": ui_identity(slot)}
        if platform_changed:
            platform_path = current / UI_PLATFORM.rstrip("/")
            candidate_path = candidate / UI_PLATFORM.rstrip("/")
            if not platform_path.is_dir() or not candidate_path.is_dir():
                raise RuntimeError("Cold UI module update requires an existing and prepared Cornice.Platform module")
            platform_slot = current / "cornice" / (".Platform-ui-" + identifier)
            platform_slot.symlink_to(candidate_path, target_is_directory=True)
            record["platform"] = {"path": str(platform_path), "slot": str(platform_slot),
                                  "originalIdentity": ui_identity(platform_path), "newIdentity": ui_identity(platform_slot)}
        manifest = dict(current_manifest)
        manifest["hashes"] = {key: value for key, value in current_manifest["hashes"].items()
                              if not key.startswith("cornice/shell/") and not key.startswith(UI_PLATFORM)} | hashes | new_platform
        manifest["uiOverlay"] = {"schema": 1, "id": candidate_manifest["id"], "sourceRelease": str(candidate),
                                 "record": str(directory), "appliedAt": time.time(), "strategy": strategy,
                                 "platformBuildId": ui_platform_id(candidate / "cornice")}
        atomic(directory / "new-manifest.json", manifest)
        atomic(directory / "record.json", record)
        atomic(active, {"record": str(directory)})
        try:
            # Recheck native control immediately before exchanging directories.
            if {item["name"] for item in ui_desktops(cli, context, cold=(strategy == "cold"))} != {shell["name"] or "main" for shell in shells}:
                raise RuntimeError("Desktop topology changed during UI update")
            ui_exchange(current / "cornice/shell", slot)
            if record.get("platform"):
                ui_exchange(record["platform"]["path"], record["platform"]["slot"])
            record["phase"] = "exchanged"
            atomic(directory / "record.json", record)
            atomic(current / "manifest.json", (directory / "new-manifest.json").read_text())
            if strategy == "cold":
                ui_desktops(cli, context, cold=True)
                record["uiReplacements"] = []
                # The old running supervisor cannot know a new maintenance
                # hook. Keep every other bar mapped while one owner replaces
                # its UI, and verify the primary before touching a secondary.
                for shell in sorted(shells, key=lambda item: bool(item["name"])):
                    fresh_info = ui_native_unchanged(context, native)
                    fresh = dict(context, info=fresh_info)
                    ui_desktops(cli, fresh, cold=True)
                    ui_stop_shell(fresh, shell)
                    peer = ui_replacement(cli, fresh, shell, candidate_manifest["id"], native,
                                          platform=ui_platform_id(candidate / "cornice"), fail_exited=True)
                    record["uiReplacements"].append(peer | {"previousPid": shell["pid"]})
                    atomic(directory / "record.json", record)
            else:
                for shell in shells:
                    ui_cli(cli, context, shell["name"], "reload-ui")
                    ui_wait(cli, context, shell, candidate_manifest["id"], platform=ui_platform_id(candidate / "cornice"))
            ui_native_unchanged(context, native)
            record.update(phase="applied", appliedAt=time.time())
            atomic(directory / "record.json", record)
        except Exception as error:
            rollback_errors = ui_restore(directory, record, context)
            suffix = "; rollback reload incomplete: " + "; ".join(rollback_errors) if rollback_errors else "; previous UI restored"
            raise RuntimeError("UI update failed: " + str(error) + suffix) from error
        print(json.dumps({"updatedUi": str(candidate), "uiBuildId": candidate_manifest["id"],
                          "currentRelease": str(current), "shells": [shell["name"] or "main" for shell in shells],
                          "rollbackRecord": str(directory), "strategy": strategy,
                          "uiReplaced": strategy == "cold", "nativePidsUnchanged": True,
                          "uiReplacements": record.get("uiReplacements", [])}, ensure_ascii=False))


def rollback_ui(args):
    with locked():
        pointer = read(STATE / "ui-overlay.json")
        if not pointer.get("record"):
            raise RuntimeError("No active UI overlay to roll back")
        directory, record, current, _ = ui_record(pointer["record"])
        info = read(STATE / "current.json") if (STATE / "current.json").exists() else {}
        context = None
        if is_running(info):
            context = ui_context(info, allow_dead_shell=True)
            if context["release"] != current:
                raise RuntimeError("UI overlay belongs to a different running session")
        if context and record.get("strategy") == "cold" and record.get("phase") == "applied":
            cli = ui_release(record["sourceRelease"]) / "cornice/bin/cornice"
            ui_desktops(cli, context, cold=True)
        errors = ui_restore(directory, record, context)
        print(json.dumps({"rolledBackUi": str(directory), "currentRelease": str(current), "reloadErrors": errors,
                          "phase": record["phase"], "replacements": record.get("replacements", [])}, ensure_ascii=False))
        if errors:
            raise RuntimeError("UI files restored, but some running shells could not reload: " + "; ".join(errors))


def prepare(args):
    # No system package, deployment pointer, service or existing configuration is changed.
    with locked():
        source = Path(args.cornice).resolve()
        identifier = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:8]
        release = STATE / "releases" / identifier
        product = release / "cornice"
        product.mkdir(parents=True, mode=0o700)
        for directory in ("bin", "shell", "i18n", "themes", "wallpapers", "config", "plugins"):
            shutil.copytree(source / directory, product / directory, ignore=shutil.ignore_patterns("__pycache__"))
        if (source / "native/bin/cornice-desktop-runtime").is_file():
            shutil.copytree(source / "native", product / "native")
        else:
            # Stage already-built components without CMake writing its install
            # manifest into the source/build tree (which may be read-only).
            build = source / "native/build"
            native_bin = product / "native/bin"
            native_bin.mkdir(parents=True)
            for name in ("cornice-desktop-runtime", "cornice-human-lock", "cornice-session-guard", "cornice-native-accessibility", "cornice-browser-runtime", "cornice-application-guard"):
                shutil.copy2(build / name, native_bin / name)
            shutil.copytree(source / "native/agent", product / "native/agent")
            module = product / "native/qml/Cornice/Desktop"
            shutil.copytree(build / "qml/Cornice/Desktop", module)
            shutil.copy2(build / "libcornice_desktop_qml.so", module / "libcornice_desktop_qml.so")
            for library in module.glob("*.so"):
                run(["patchelf", "--set-rpath", "$ORIGIN", library])
        for name in ("cornice-desktop-runtime", "cornice-human-lock", "cornice-session-guard",
                     "cornice-native-accessibility", "cornice-browser-runtime", "cornice-application-guard"):
            binary = product / "native/bin" / name
            if not binary.is_file() or not os.access(binary, os.X_OK):
                raise RuntimeError("Candidate is missing an executable native component: " + name)
        if not (product / "native/agent/desktop-endpoint.mjs").is_file():
            raise RuntimeError("Candidate is missing the native agent endpoint module: desktop-endpoint.mjs")
        platform = source / "native/qml/Cornice/Platform"
        if not platform.is_dir():
            platform = source / "native/platform-build/qml/Cornice/Platform"
        target_module = product / "native/qml/Cornice/Platform"
        if not target_module.is_dir():
            shutil.copytree(platform, target_module)
            shutil.copy2(source / "native/platform-build/libcornice_platform.so", target_module / "libcornice_platform.so")
            for library in target_module.glob("*.so"):
                run(["patchelf", "--set-rpath", "$ORIGIN", library])
        shutil.copy2(Path(args.hyprland).resolve(), release / "Hyprland")
        shutil.copy2(__file__, release / "runner")
        configuration = native_screenshot_bindings(native_layout_bindings(Path(args.config).read_text()), product)
        configuration = configuration.replace(str(source), str(product))
        # The old bootstrap rewrites real config and starts cornice.service. Suppress it.
        # Route existing absolute Cornice shortcuts to this immutable candidate instead.
        configuration = configuration.replace(str(Path.home() / ".local/bin/cornice"), str(product / "bin/cornice"))
        configuration = configuration.replace('\\"$HOME/.local/bin/cornice\\"', '\\"' + str(product / "bin/cornice") + '\\"')
        configuration = configuration.replace("~/.config/hypr/scripts/cycle-focus-fullscreen.sh", str(product / "bin/cornice-cycle-focus"))
        # Hyprland's standard orphan-lock recovery policy is opt-in. Enable it
        # only in this candidate snapshot so a crashed locker can show its
        # authentication UI again; restoring the lock never authenticates or unlocks.
        configuration += "\n-- Candidate-only recovery of the session-lock authentication UI.\n"
        configuration += "hl.config({misc={allow_session_lock_restore=true}})\n"
        atomic(release / "hyprland.lua", configuration)
        commands = read(args.autostart) if args.autostart else []
        if not isinstance(commands, list) or not all(isinstance(c, str) for c in commands):
            raise RuntimeError("Autostart must be a JSON array of commands")
        # User manager's Cornice remains the stable version. Trial shell is supervised directly.
        commands = [c for c in commands if "cornice.service" not in c]
        atomic(release / "autostart.json", commands)
        config_root = release / "config-home"
        config_root.mkdir()
        original = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
        for child in original.iterdir() if original.exists() else ():
            if child.name == "chrome-flags.conf" and child.is_file():
                # Stable Xwayland's fixed 2x becomes another multiplier on native
                # Wayland's 2x output. Change only the trial's configuration copy.
                flags = re.sub(r"(?m)^\s*--force-device-scale-factor=[^\n]+\n?", "", child.read_text())
                flags = re.sub(r"(?m)^\s*--ozone-platform=[^\n]+\n?", "", flags)
                atomic(config_root / child.name, flags.rstrip() + "\n--ozone-platform=wayland\n")
            elif child.name == "fcitx5" and child.is_dir():
                shutil.copytree(child, config_root / child.name, symlinks=False)
                classic = config_root / child.name / "conf/classicui.conf"
                if classic.is_file():
                    text = classic.read_text()
                    # The stable X11 setup compensates with 24pt. This native
                    # Wayland session applies the output scale automatically.
                    text = re.sub(r'(?m)^Font="?Sans 24"?\s*$', 'Font="Sans 12"', text)
                    atomic(classic, text)
            elif child.name != "cornice":
                (config_root / child.name).symlink_to(child.resolve(), target_is_directory=child.is_dir())
        if (original / "cornice").exists():
            shutil.copytree(original / "cornice", config_root / "cornice", symlinks=False)
        else:
            (config_root / "cornice").mkdir()
        config_file = config_root / "cornice/config.json"
        settings = read(config_file) if config_file.exists() else {}
        settings["agentDesktop"] = {"enabled": True, "desktops": [],
                                    "alwaysShowPreviews": settings.get("agentDesktop", {}).get("alwaysShowPreviews") is True,
        "previewWidth": settings.get("agentDesktop", {}).get("previewWidth", 320),
        "previewCardHeight": settings.get("agentDesktop", {}).get("previewCardHeight", 220)}
        layout = settings.setdefault("bar", {}).setdefault("layout", {})
        # A configured entry in any section already provides both controls.
        found = False
        for section in ("left", "center", "right"):
            entries = []
            for item in layout.get(section, []):
                identity = item if isinstance(item, str) else item.get("id")
                if identity == "cn.agent-desktop":
                    if found:
                        continue
                    found = True
                entries.append(item)
            layout[section] = entries
        if not found:
            layout["left"].append({"id": "cn.agent-desktop"})
        # The requested screenshot entry is visible in the candidate even when
        # the existing layout predates this widget. Preserve an explicit placement.
        if not any((item if isinstance(item, str) else item.get("id")) == "cn.screenshot"
                   for section in ("left", "center", "right") for item in layout[section]):
            right = layout["right"]
            index = next((i for i, item in enumerate(right)
                          if (item if isinstance(item, str) else item.get("id")) == "cn.menu"), len(right))
            right.insert(index, {"id": "cn.screenshot"})
        atomic(config_file, settings)
        ui_build(product / "shell", identifier)
        files = [p for p in product.rglob("*") if p.is_file()]
        files += [release / name for name in ("Hyprland", "runner", "hyprland.lua", "autostart.json")]
        stable_cli = (Path.home() / ".local/bin/cornice").resolve()
        stable_files = {"/usr/bin/Hyprland": digest("/usr/bin/Hyprland"),
                        "/usr/bin/start-hyprland": digest("/usr/bin/start-hyprland")}
        for directory in (stable_cli.parent, stable_cli.parent.parent / "shell"):
            if directory.is_dir():
                for path in directory.rglob("*"):
                    if path.is_file() and "__pycache__" not in path.parts:
                        stable_files[str(path)] = digest(path)
        manifest = {"id": identifier, "release": str(release), "product": str(product),
                    "hashes": {str(p.relative_to(release)): digest(p) for p in files},
                    "loginSelectionSchema": SELECTION_SCHEMA,
                    "stable": {"entry": "/usr/bin/start-hyprland", "hyprland": digest("/usr/bin/Hyprland"),
                               "cornice": str(stable_cli), "hashes": stable_files}}
        atomic(release / "manifest.json", manifest)
        atomic(STATE / "prepared.json", {"release": str(release)})
        print(json.dumps({"prepared": str(release), "armed": False}, ensure_ascii=False))


def verify_release(release):
    manifest = read(release / "manifest.json")
    for relative, expected in manifest["hashes"].items():
        if digest(release / relative) != expected:
            raise RuntimeError("Candidate changed after preparation: " + relative)
    # We never overwrite stable files; reject a drifted system binary instead of promising an old fallback.
    for path, expected in manifest["stable"]["hashes"].items():
        if digest(path) != expected:
            raise RuntimeError("Stable version changed; prepare a fresh baseline: " + path)
    return manifest


def arm(args):
    with locked():
        current = read(STATE / "current.json") if (STATE / "current.json").exists() else {}
        release = Path(read(STATE / "prepared.json")["release"])
        if is_running(current):
            if not args.after_current:
                raise RuntimeError("A trial is already running; use --after-current only to explicitly select a different candidate for the next login")
            if str(release) == current.get("release"):
                raise RuntimeError("Prepare a different candidate before arming after the current trial")
        cancel_ticket()
        verify_release(release)
        selected = selection()
        install_login_hook(Path(selected["release"]) if selected else release)
        # Durable, one-use ticket. Login consumes it before launching any candidate code.
        atomic(STATE / "pending.json", {"release": str(release), "startupSeconds": args.startup_seconds, "armedAt": time.time()})
        print("Armed for ONE SDDM Hyprland login. Current session unchanged.")


def install_login_hook(release):
    profile = Path(os.environ.get("ZDOTDIR", str(Path.home()))) / ".zprofile"
    profile = profile.resolve()
    contents = profile.read_text() if profile.exists() else ""
    if HOOK_BEGIN not in contents:
        atomic(STATE / "login-profile-backup.json", {"path": str(profile), "existed": profile.exists(), "contents": contents})
    runner = ("/usr/bin/env " + shlex.quote("CORNICE_TRIAL_STATE_DIR=" + str(STATE)) +
              " /usr/bin/python3 " + shlex.quote(str(release / "runner")))
    hook = (f"\n{HOOK_BEGIN}\n"
            f"if {runner} is-login \"$$\"; then\n"
            f"  exec {runner} login\nfi\n{HOOK_END}\n")
    mode = profile.stat().st_mode & 0o777 if profile.exists() else 0o600
    atomic(profile, remove_block(contents) + hook)
    profile.chmod(mode)


def selection():
    path = STATE / "selection.json"
    if not path.exists():
        return None
    value = read(path)
    if (not isinstance(value, dict) or value.get("schema") != SELECTION_SCHEMA or
            not isinstance(value.get("id"), str) or not re.fullmatch(r"[a-f0-9]{32}", value["id"]) or
            not isinstance(value.get("release"), str) or
            type(value.get("startupSeconds")) is not int or not 5 <= value["startupSeconds"] <= 300):
        raise ValueError("Invalid persistent login selection")
    release = Path(value["release"])
    if not release.is_absolute() or release.resolve().parent != (STATE / "releases").resolve():
        raise ValueError("Selected release is outside the prepared release directory")
    return value


def clear_selection(identity=None, reason=None):
    # An old session must not revoke a newer selection made while it ran, or
    # delete the newer session's launch marker.
    selected_path = STATE / "selection.json"
    marker_path = STATE / "selection-launch.json"
    preserve = False
    if identity is not None:
        try:
            selected = selection()
            preserve = bool(selected and selected["id"] != identity)
        except (OSError, ValueError):
            pass
    if not preserve:
        selected_path.unlink(missing_ok=True)
    try:
        marker = read(marker_path) if marker_path.exists() else None
    except (OSError, ValueError):
        marker = None
    if identity is None or not isinstance(marker, dict) or marker.get("selectionId") == identity:
        marker_path.unlink(missing_ok=True)
    descriptor = os.open(STATE, os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    if reason and not preserve:
        atomic(STATE / "selection-failure.json", {"reason": reason, "at": time.time()})


def select_release(args):
    with locked():
        release = Path(args.release).resolve() if args.release else Path(read(STATE / "prepared.json")["release"]).resolve()
        if release.parent != (STATE / "releases").resolve():
            raise RuntimeError("Select only an immutable release in this state directory")
        manifest = verify_release(release)
        if manifest.get("loginSelectionSchema") != SELECTION_SCHEMA:
            raise RuntimeError("This snapshot runner only supports one-shot login; prepare a fresh snapshot")
        install_login_hook(release)
        cancel_ticket()
        atomic(STATE / "selection.json", {"schema": SELECTION_SCHEMA, "id": uuid.uuid4().hex,
            "release": str(release), "startupSeconds": args.startup_seconds, "selectedAt": time.time()})
        print("Selected for future Hyprland logins; previous pending trial cancelled. Current session unchanged.")


def selection_marker():
    path = STATE / "selection-launch.json"
    if not path.exists():
        return None
    value = read(path)
    if (not isinstance(value, dict) or not isinstance(value.get("selectionId"), str) or
            not re.fullmatch(r"[a-f0-9]{32}", value["selectionId"]) or
            type(value.get("pid")) is not int or value["pid"] <= 0 or
            not isinstance(value.get("processStart"), str) or not value["processStart"].isdigit()):
        raise ValueError("Invalid persistent launch marker")
    return value


def login_ticket():
    # Called while holding both session.lock and control.lock. A durable launch
    # marker survives SIGKILL/power loss, preventing an endless failed login loop.
    try:
        selected = selection()
        marker = selection_marker()
        if marker is not None:
            if is_running(marker):
                raise RuntimeError("A selected session is already running")
            if selected and selected["id"] == marker["selectionId"]:
                clear_selection(selected["id"], "Previous selected session did not finish safely; stable login selected")
                selected = None
            else:
                (STATE / "selection-launch.json").unlink(missing_ok=True)
    except (OSError, ValueError) as error:
        clear_selection(reason=str(error))
        selected = None
    pending = STATE / "pending.json"
    if pending.exists():
        pending.replace(STATE / "consumed.json")
        descriptor = os.open(STATE, os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        ticket = read(STATE / "consumed.json")
        if not isinstance(ticket, dict) or not isinstance(ticket.get("release"), str) or type(ticket.get("startupSeconds")) is not int or not 5 <= ticket["startupSeconds"] <= 300:
            raise ValueError("Invalid one-shot ticket")
        return dict(ticket, persistent=False)
    if not selected:
        return None
    atomic(STATE / "selection-launch.json", {"selectionId": selected["id"], "pid": os.getpid(),
        "processStart": start_identity(os.getpid())})
    return dict(selected, selectionId=selected["id"], persistent=True)


def finish_selection(ticket, normal_end):
    if not ticket.get("persistent"):
        return  # Finishing a one-shot never cancels a separately selected release.
    with locked():
        if not normal_end:
            clear_selection(ticket["selectionId"], "Selected session failed; stable login selected")
            return
        marker_path = STATE / "selection-launch.json"
        marker = read(marker_path) if marker_path.exists() else None
        if marker and marker.get("selectionId") == ticket["selectionId"]:
            marker_path.unlink()
            descriptor = os.open(STATE, os.O_DIRECTORY)
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)


def next_login():
    error = None
    try:
        selected = selection()
    except (OSError, ValueError) as problem:
        selected = None
        error = str(problem)
    pending = STATE / "pending.json"
    if pending.exists():
        try:
            ticket = read(pending)
            intent = {"mode": "trial", "release": ticket.get("release")}
        except (OSError, ValueError, AttributeError) as problem:
            intent = {"mode": "trial", "error": str(problem)}
    elif selected:
        intent = {"mode": "persistent", "release": selected["release"]}
        marker_path = STATE / "selection-launch.json"
        if marker_path.exists():
            try:
                marker = selection_marker()
                if marker and marker["selectionId"] == selected["id"] and not is_running(marker):
                    intent = {"mode": "stable", "reason": "Interrupted selected session; selection will be cleared at login"}
            except (OSError, ValueError):
                intent = {"mode": "stable", "reason": "Invalid launch marker; selection will be cleared at login"}
    else:
        intent = {"mode": "stable"}
    return selected, intent, error


def login_matches(pid):
    try:
        arguments = Path(f"/proc/{int(pid)}/cmdline").read_bytes().split(b"\0")
        return (b"/usr/bin/start-hyprland" in arguments and
                any(a.endswith(b"/wayland-session") for a in arguments) and
                ((STATE / "pending.json").exists() or (STATE / "selection.json").exists() or
                 (STATE / "selection-launch.json").exists()))
    except (OSError, ValueError):
        return False


def start_identity(pid):
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except OSError:
        return None


def is_running(info):
    if (not isinstance(info, dict) or type(info.get("pid")) is not int or info["pid"] <= 0 or
            not isinstance(info.get("processStart"), str) or not info["processStart"].isdigit()):
        return False
    identity = start_identity(info["pid"])
    return identity is not None and info["processStart"] == identity


def request(action):
    with locked():
        info = read(STATE / "current.json") if (STATE / "current.json").exists() else {}
        if action == "rollback":
            cancel_ticket()
            clear_selection()
        if not is_running(info) or info["status"] not in ("starting", "ready", "confirmed"):
            if action == "rollback":
                print("Stable login selected; no running trial to end.")
                return
            raise RuntimeError("No running trial")
        if action == "confirm" and info["status"] == "starting":
            raise RuntimeError("Trial has not passed startup checks")
        atomic(Path(info["run"]) / action, {"requestedAt": time.time()})
        print("Requested " + action + " for trial session only.")


def ipc(env, command, structured=True):
    target = Path(env["XDG_RUNTIME_DIR"]) / "hypr" / env["HYPRLAND_INSTANCE_SIGNATURE"] / ".socket.sock"
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(2)
        connection.connect(str(target))
        connection.sendall((("j/" if structured else "/") + command).encode())
        result = bytearray()
        while data := connection.recv(65536):
            result.extend(data)
            if len(result) > 16 * 1024 * 1024:
                raise RuntimeError("Compositor reply too large")
    text = result.decode().strip()
    return json.loads(text) if structured else text


def child_setup():
    # If the supervisor itself dies, do not strand a compositor on the display.
    parent = os.getppid()
    ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGKILL, 0, 0, 0)
    if os.getppid() != parent or parent == 1:
        os._exit(1)


class ComponentUnhealthy(RuntimeError):
    def __init__(self, component, message):
        super().__init__(message)
        self.component = component


class DesktopUiUnhealthy(RuntimeError):
    """A secondary UI failed; its Broker and applications can remain healthy."""
    def __init__(self, desktop, message):
        super().__init__(message)
        self.desktop = desktop


class DesktopTopologyError(RuntimeError):
    """Managed intent/native topology is invalid; restarting Broker is not repair."""


class Trial:
    def __init__(self, ticket):
        self.ticket = ticket
        self.release = Path(ticket["release"])
        self.product = self.release / "cornice"
        self.directory = STATE / "runs" / (time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:8])
        self.directory.mkdir(parents=True, mode=0o700)
        self.children = []
        self.sockets = []
        self.desktop_startups = {}
        self.ready_desktops = set()
        self.components = {}
        self.recovery = {}
        self.component_failures = {}
        self.desktop_ui_restarts = {}
        self.compositor = None
        self.health_failures = 0
        self.next_health_check = 0.0
        self.environment = os.environ.copy()
        for key in ("HYPRLAND_INSTANCE_SIGNATURE", "DISPLAY", "WAYLAND_SOCKET", "CORNICE_LAUNCH_LOCKED"):
            self.environment.pop(key, None)
        self.environment.update(CORNICE_PATH=str(self.product), CORNICE_SESSION_TEST="1", CORNICE_TRIAL_STATE_DIR=str(STATE),
                                XDG_CONFIG_HOME=str(self.release / "config-home"),
                                PATH=str(self.product / "bin") + ":" + self.environment["PATH"],
                                HYPRLAND_NO_SD_VARS="1", HYPRLAND_NO_SD_TARGET="1", HYPRLAND_NO_SD_NOTIFY="1",
                                QS_DISABLE_FILE_WATCHER="1", QS_NO_RELOAD_POPUP="1")
        self.info = {"pid": os.getpid(), "processStart": start_identity(os.getpid()), "run": str(self.directory),
                     "release": str(self.release), "status": "starting", "persistent": bool(ticket.get("persistent")),
                     "stableSelected": not (STATE / "selection.json").exists()}
        self.interrupted = False

    def update(self, status, **kwargs):
        self.info.update(status=status, updatedAt=time.time(), **kwargs)
        atomic(STATE / "current.json", self.info)
        atomic(self.directory / "status.json", self.info)

    def start(self, arguments, name):
        with (self.directory / (name + ".log")).open("a") as logfile:
            process = subprocess.Popen(list(map(str, arguments)), env=self.environment, stdout=logfile,
                                       stderr=subprocess.STDOUT, process_group=0, preexec_fn=child_setup)
        self.children.append(process)
        return process

    def component(self, arguments, name):
        process = self.start(arguments, name)
        self.components[name] = {"arguments": arguments, "process": process, "restarts": [], "retryAt": 0.0}
        return process

    def recover_component(self, name, reason):
        component = self.components[name]
        now = time.monotonic()
        component["restarts"] = [at for at in component["restarts"] if now - at < 60]
        if len(component["restarts"]) >= 3:
            component["retryAt"] = component["restarts"][0] + 60
            self.report_health(degraded=True, recoveryRequired=name,
                recoveryRetryAt=time.time() + max(0, component["retryAt"] - now),
                lastHealthError=name + " recovery budget exhausted: " + reason)
            return False
        if now < component["retryAt"]:
            return False
        # Reserve the attempt before stop/start. A failed fork must count too;
        # otherwise resource exhaustion becomes an unlimited restart loop.
        component["restarts"].append(now)
        component["retryAt"] = now + min(20, 2 ** len(component["restarts"]))
        # Restarting UI must not silently continue old input grants. The native
        # guardian independently keeps/escalates any existing lock on UI death.
        if name == "cornice":
            try:
                for desktop in json.loads(self.command("desktop", "list"))["desktops"]:
                    self.command("desktop", "pause", desktop["name"])
            except (OSError, RuntimeError, ValueError, subprocess.SubprocessError):
                pass  # Broker death is independently fail-closed in Hyprland.
        process = component["process"]
        if process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGCONT)
                os.killpg(process.pid, signal.SIGTERM)
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL); process.wait(timeout=2)
            except ProcessLookupError:
                pass
        component["process"] = self.start(component["arguments"], name + "-recovery")
        self.info["brokerPid" if name == "desktop" else "shellPid"] = component["process"].pid
        self.recovery[name] = now + 20
        self.component_failures[name] = 0
        self.report_health(componentRecovery=self.component_status(), lastHealthError=reason,
                           recoveryRetryAt=None)
        return True

    def recover_desktop_ui(self, name):
        # Broker owns and automatically restarts each secondary QProcess. A
        # missing bar is not evidence that this healthy native owner died.
        context = ui_context(self.info)
        cli = self.product / "bin/cornice"
        ui_desktops(cli, context)
        try:
            peer = ui_socket_peer(context, name)
        except (OSError, RuntimeError):
            return False  # Dead UI: let the Broker's existing retry start it.
        now = time.monotonic()
        restarts = [at for at in self.desktop_ui_restarts.get(name, []) if now - at < 60]
        self.desktop_ui_restarts[name] = restarts
        if len(restarts) >= 3:
            return False
        self.command("desktop", "pause", name)
        ui_stop_shell(context, peer)
        restarts.append(now)
        return True

    def component_status(self):
        return {name: {"attempts": len(component["restarts"]),
                       "recovering": name in self.recovery,
                       "pid": component["process"].pid}
                for name, component in self.components.items()}

    def report_health(self, **details):
        # Status persistence is diagnostic after readiness. A full filesystem,
        # temporary FD shortage or failed fsync must not become a logout request.
        previous_error = self.info.pop("statusWriteError", None)
        try:
            self.update(self.info["status"], **details)
        except (OSError, ValueError) as error:
            self.info.update(**details)
            self.info["statusWriteError"] = str(error)
            if previous_error != str(error):
                try:
                    print("cornice trial: cannot persist health status: " + str(error), file=sys.stderr)
                except (OSError, ValueError):
                    pass  # A failed diagnostic sink cannot end a ready session.

    def mark_ready(self):
        # Startup validation is complete. Persisting this transition is now a
        # diagnostic operation, so ENOSPC/failed fsync cannot undo a usable login.
        self.info["status"] = "ready"
        self.report_health(confirmationRequired=False, healthFailures=0, lastHealthyAt=time.time())

    def auxiliary_failure(self, name, error):
        failures = self.info.setdefault("auxiliaryStartFailures", [])
        failures.append({"name": name, "error": str(error), "at": time.time()})
        del failures[:-32]
        self.report_health(degraded=True, lastHealthError=name + ": " + str(error))

    def start_ready_auxiliaries(self):
        # Unlike required pre-ready components, optional autostarts and the
        # notification are not allowed to tear down a verified desktop.
        self.check_request()
        try:
            commands = read(self.release / "autostart.json")
            if not isinstance(commands, list) or not all(isinstance(command, str) for command in commands):
                raise ValueError("Autostart must be a JSON array of commands")
        except (OSError, ValueError, TypeError) as error:
            self.auxiliary_failure("autostart configuration", error)
            commands = []
        notice = ("试运行桌面：启动检查已通过，后台持续检查；无需确认，不会因超时退出。"
                  "有问题按 Super+Ctrl+Alt+Backspace 回退；下次登录版本见 session-trial status。")
        starts = [(["/bin/sh", "-c", command], "autostart-" + str(index)) for index, command in enumerate(commands)]
        starts.append((["notify-send", "Cornice 试运行", notice, "--expire-time=0"], "notice"))
        for arguments, name in starts:
            self.check_request()  # Explicit termination stays outside the guard.
            try:
                self.start(arguments, name)
            except Exception as error:
                self.auxiliary_failure(name, error)

    def supervise_once(self):
        self.check_request()  # An explicit rollback still ends the session.
        if self.compositor.poll() is not None:
            reason = "Hyprland exited normally" if self.compositor.returncode == 0 else "Hyprland exited unexpectedly"
            self.report_health(reason=reason)
            self.update("exited" if self.compositor.returncode == 0 else "rolled-back", reason=reason)
            return False
        if (self.directory / "confirm").exists() and self.info["status"] != "confirmed":
            try:
                self.update("confirmed")
            except (OSError, ValueError) as error:
                self.report_health(statusWriteError=str(error))
        now = time.monotonic()
        if now < self.next_health_check:
            return True
        self.next_health_check = now + .5
        try:
            self.health()
            if (self.health_failures or self.component_failures or self.recovery or
                    self.info.get("degraded") or time.time() - self.info["lastHealthyAt"] >= 5):
                self.recovery.clear()
                self.report_health(healthFailures=0, lastHealthError=None,
                    lastHealthyAt=time.time(), degraded=False, recoveryRequired=None,
                    recoveryRetryAt=None, componentRecovery=self.component_status())
            self.health_failures = 0
            self.component_failures.clear()
        except ComponentUnhealthy as error:
            name = error.component
            self.component_failures[name] = self.component_failures.get(name, 0) + 1
            component = self.components[name]
            dead = component["process"].poll() is not None
            grace = name in self.recovery and now < self.recovery[name]
            self.report_health(healthFailures=self.component_failures[name], lastHealthError=str(error))
            if dead or (not grace and self.component_failures[name] >= 3):
                try:
                    self.recover_component(name, str(error))
                except Exception as recovery_error:
                    # Repair also parses component replies: valid JSON with a
                    # broken shape must not escape this handler and log out.
                    # Explicit termination stays in check_request above.
                    # Failed component repair leaves the compositor running and
                    # existing native lock/input guardians fail-closed.
                    self.report_health(degraded=True, lastHealthError=str(recovery_error),
                        recoveryRequired=name, componentRecovery=self.component_status())
            if self.info.get("degraded"):
                self.next_health_check = now + 2
        except DesktopUiUnhealthy as error:
            key = "ui:" + error.desktop
            self.component_failures[key] = self.component_failures.get(key, 0) + 1
            self.report_health(degraded=True, recoveryRequired=key, lastHealthError=str(error),
                               healthFailures=self.component_failures[key])
            if self.component_failures[key] >= 3:
                try:
                    self.recover_desktop_ui(error.desktop)
                except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as recovery_error:
                    self.report_health(lastHealthError=str(error) + "; UI recovery: " + str(recovery_error))
            self.next_health_check = now + .5
        except Exception as error:
            # Probe payloads can be valid JSON with a broken shape, raising
            # KeyError/TypeError/AttributeError. Such component diagnostics are
            # not logout requests; check_request above retains that boundary.
            self.health_failures += 1
            self.report_health(healthFailures=self.health_failures, lastHealthError=str(error))
            if self.health_failures >= 3:
                self.report_health(degraded=True, recoveryRequired="diagnostics")
                self.next_health_check = now + min(5, self.health_failures - 1)
        return True

    def command(self, *args):
        return run([self.product / "bin/cornice", *args], env=self.environment)

    def check_request(self):
        if self.interrupted or (self.directory / "rollback").exists():
            raise RuntimeError("Manual rollback or session termination requested")

    def desktop_definitions(self, allow_missing=False):
        directory = Path(self.environment.get("XDG_STATE_HOME") or
                         str(Path(self.environment["HOME"]) / ".local/state"))
        path = directory / "cornice/desktops.json"
        try:
            with path.open("rb") as stream:
                contents = stream.read(1024 * 1024 + 1)
        except FileNotFoundError:
            if allow_missing:
                return None
            raise DesktopTopologyError("Managed desktop definitions are unavailable")
        except OSError as error:
            raise DesktopTopologyError("Cannot read managed desktop definitions: " + str(error)) from error
        if len(contents) > 1024 * 1024:
            raise DesktopTopologyError("Managed desktop definitions are too large")
        try:
            value = json.loads(contents)
        except ValueError as error:
            raise DesktopTopologyError("Invalid managed desktop definitions: " + str(error)) from error
        if (not isinstance(value, dict) or value.get("schema") != 1 or
                not isinstance(value.get("desktops"), dict)):
            raise DesktopTopologyError("Invalid managed desktop definitions")
        definitions = value["desktops"]
        if not all(isinstance(name, str) and re.fullmatch(r"[A-Za-z0-9_-]{1,64}", name)
                   and isinstance(spec, dict) for name, spec in definitions.items()):
            raise DesktopTopologyError("Invalid managed desktop definition entry")
        return definitions

    def managed_desktops(self):
        # Broker's list contains managed definitions including restore failures,
        # not just surviving live seats. Check the persisted intent as well so a
        # vanished seat/output cannot be mistaken for a legitimate deletion.
        # Definitions can change legally while IPC is in flight: retry only the
        # read-only snapshot, never replay a creation or policy operation.
        for _ in range(3):
            before = self.desktop_definitions()
            value = json.loads(self.command("desktop", "list"))
            if (not isinstance(value, dict) or not isinstance(value.get("desktops"), list) or
                    not all(isinstance(desktop, dict) and isinstance(desktop.get("name"), str)
                            for desktop in value["desktops"])):
                raise RuntimeError("Invalid managed desktop list")
            desktops = value["desktops"]
            definitions = self.desktop_definitions()
            if before != definitions:
                continue
            names = [desktop["name"] for desktop in desktops]
            if len(names) != len(set(names)) or set(names) != set(definitions):
                raise DesktopTopologyError("Managed desktop list does not match its definitions")
            if sum(desktop.get("primary") is True for desktop in desktops) != 1:
                raise DesktopTopologyError("Managed primary desktop is missing")
            for desktop in desktops:
                name = desktop["name"]
                # View availability is control state: readonly presentation,
                # DPMS and session lock can make a healthy seat unavailable to
                # input. Native identity/topology, not input permission, is the
                # health requirement; failed restores remain explicit errors.
                if desktop.get("error") or not isinstance(desktop.get("seatId"), str) or not desktop["seatId"]:
                    raise DesktopTopologyError("Managed desktop is unavailable: " + name +
                                       ": " + str(desktop.get("error", "native seat identity unavailable")))
                if desktop.get("stableId") != definitions[name].get("stableId"):
                    raise DesktopTopologyError("Managed desktop identity changed: " + name)
            return desktops
        raise DesktopTopologyError("Managed desktop definitions changed during health check")

    def initialize_desktops(self, new_installation):
        desktops = self.managed_desktops()
        secondary = [desktop for desktop in desktops if not desktop.get("primary")]
        # Only Broker's newly seeded default gets the deployment's established
        # continuation policy. Existing names, count and policies are user intent.
        if new_installation and len(secondary) == 1:
            self.command("desktop", "lock-policy", secondary[0]["name"], "continue")
        self.info["desktops"] = [desktop["name"] for desktop in desktops]

    def health(self):
        self.check_request()
        for name, component in self.components.items():
            self.info["healthStage"] = name + ".process"
            if component["process"].poll() is not None:
                raise ComponentUnhealthy(name, name + " process exited")
        self.info["healthStage"] = "compositor.version"
        version = ipc(self.environment, "version")
        if version.get("commit") != self.version.get("commit"):
            raise RuntimeError("Wrong compositor instance")
        # Lua also appends failed runtime dispatch/eval calls to configerrors.
        # An application command error is diagnostic, not proof that a healthy
        # desktop must be terminated. Configuration is still required to be
        # error-free during startup, before any user applications are launched.
        self.info["healthStage"] = "compositor.configerrors"
        self.info["configurationErrors"] = ipc(self.environment, "configerrors", False)
        self.info["healthStage"] = "compositor.monitors"
        monitors = ipc(self.environment, "monitors")
        if not monitors:
            raise RuntimeError("No visible output")
        output_names = {monitor["name"] for monitor in monitors}
        self.info["healthStage"] = "cornice.ping"
        try:
            if not self.command("ping").startswith("pong"):
                raise RuntimeError("Cornice did not answer ping")
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            raise ComponentUnhealthy("cornice", str(error)) from error
        self.info["healthStage"] = "compositor.layers"
        layers = ipc(self.environment, "layers")
        if not any(layer.get("namespace") == "cornice-bar" for monitor in layers.values()
                   for level in monitor.get("levels", {}).values() for layer in level):
            raise ComponentUnhealthy("cornice", "Cornice bar is missing")
        self.info["healthStage"] = "desktop.list"
        try:
            desktops = self.managed_desktops()
        except DesktopTopologyError:
            # A valid service response reporting a missing seat/output or bad
            # persisted intent is diagnostic. Restarting every desktop owner
            # would change the requested topology and revoke unrelated input.
            raise
        except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
            raise ComponentUnhealthy("desktop", str(error)) from error
        self.info["desktops"] = [d["name"] for d in desktops]
        identities = {(d["name"], d.get("seatId")) for d in desktops}
        self.ready_desktops.intersection_update(identities)
        self.desktop_startups = {identity: started for identity, started in self.desktop_startups.items() if identity in identities}
        initializing = []
        self.info["healthStage"] = "desktop.topology"
        for desktop in desktops:
            if desktop.get("output") not in output_names:
                raise RuntimeError("Desktop output is missing: " + desktop["name"])
            if not desktop.get("primary"):
                # Capture only real compositor-reported private sockets from this
                # instance, including desktops added after startup. Cleanup still
                # verifies inode/device and never unlinks a replacement socket.
                display = desktop.get("display", "")
                if not re.fullmatch(r"[A-Za-z0-9_.-]+", display):
                    raise RuntimeError("Invalid private desktop display")
                path = Path(self.environment["XDG_RUNTIME_DIR"]) / display
                identity = path.lstat()
                if not stat.S_ISSOCK(identity.st_mode) or identity.st_uid != os.getuid():
                    raise RuntimeError("Private desktop display is unavailable")
                owned = (path, identity.st_dev, identity.st_ino)
                if owned not in self.sockets:
                    self.sockets.append(owned)
            if len(desktop.get("workspaceSlots", [])) != 10:
                raise RuntimeError("Agent workspace slots are missing")
            identity = (desktop["name"], desktop.get("seatId"))
            if not any(layer.get("namespace") == "cornice-bar"
                       for level in layers.get(desktop["output"], {}).get("levels", {}).values() for layer in level):
                # Only the first bar map of a new dynamic desktop has a bounded
                # initialization window. Its output/socket/slots still must be
                # real and healthy; startup and previously-ready bars are strict.
                if self.info["status"] != "starting" and identity not in self.ready_desktops:
                    first_seen = self.desktop_startups.setdefault(identity, time.monotonic())
                    if time.monotonic() - first_seen < self.ticket["startupSeconds"]:
                        initializing.append(desktop["name"])
                        continue
                message = "Desktop Cornice bar is missing: " + desktop["name"]
                if desktop.get("primary"):
                    raise ComponentUnhealthy("cornice", message)
                raise DesktopUiUnhealthy(desktop["name"], message)
            self.ready_desktops.add(identity)
        self.info["initializingDesktops"] = initializing
        self.info["healthStage"] = "complete"

    def execute(self):
        self.update("starting")
        config = self.directory / "hyprland.lua"
        # The control runner may be newer than a prioritized one-shot release.
        # Its rollback must also revoke the persistent selection it owns.
        runner = shlex.join(["/usr/bin/python3", str(Path(__file__).resolve())])
        # Additional hotkeys work even when the Cornice UI is broken.
        config.write_text((self.release / "hyprland.lua").read_text() + "\n" +
            'hl.config({misc={disable_watchdog_warning=true}})\n' +
            'hl.bind("SUPER + CTRL + ALT + BackSpace", hl.dsp.exec_cmd(' + json.dumps(runner + " rollback") + '), {locked=true,submap_universal=true})\n' +
            'hl.bind("SUPER + CTRL + ALT + Return", hl.dsp.exec_cmd(' + json.dumps(runner + " confirm") + '), {submap_universal=true})\n')
        compositor = self.start([self.release / "Hyprland", "-c", config], "Hyprland")
        self.compositor = compositor
        self.info["compositorPid"] = compositor.pid
        self.update("starting")
        deadline = time.monotonic() + self.ticket["startupSeconds"]
        runtime = Path(self.environment["XDG_RUNTIME_DIR"])
        while time.monotonic() < deadline:
            self.check_request()
            if compositor.poll() is not None:
                raise RuntimeError("Hyprland exited during startup")
            for candidate in (runtime / "hypr").glob("*/hyprland.lock"):
                try:
                    pid, display = candidate.read_text().splitlines()[:2]
                    if int(pid) != compositor.pid:
                        continue
                    self.environment.update(HYPRLAND_INSTANCE_SIGNATURE=candidate.parent.name, WAYLAND_DISPLAY=display)
                    self.version = ipc(self.environment, "version")
                    if not ipc(self.environment, "monitors"):
                        continue
                    break
                except (OSError, ValueError, IndexError):
                    continue
            else:
                time.sleep(.1)
                continue
            break
        else:
            raise RuntimeError("Hyprland startup timeout")
        self.info["instance"] = self.environment["HYPRLAND_INSTANCE_SIGNATURE"]
        self.info["display"] = self.environment["WAYLAND_DISPLAY"]
        errors = ipc(self.environment, "configerrors", False)
        if errors:
            raise RuntimeError("Hyprland configuration errors: " + errors)
        # Lua hl.env changes the compositor's child environment, not its parent.
        # Export through a compositor-spawned child before directly supervising
        # Cornice/autostarts; otherwise IM modules and application scaling vanish.
        environment_file = self.directory / "launch-environment"
        atomic(environment_file, "")
        try:
            command = "/usr/bin/env -0 > " + shlex.quote(str(environment_file))
            ipc(self.environment, "dispatch hl.dsp.exec_cmd(" + json.dumps(command) + ")", False)
            while time.monotonic() < deadline:
                self.check_request()
                contents = environment_file.read_bytes()
                if contents.endswith(b"\0"):
                    exported = dict(item.decode().split("=", 1) for item in contents.split(b"\0") if b"=" in item)
                    self.environment.update(exported)
                    break
                time.sleep(.05)
            else:
                raise RuntimeError("Compositor launch environment export failed")
        finally:
            environment_file.unlink(missing_ok=True)
        previous_definitions = self.desktop_definitions(allow_missing=True)
        legacy_definitions = (runtime / "cornice" / self.environment["HYPRLAND_INSTANCE_SIGNATURE"] / "desktops.json")
        new_installation = previous_definitions is None and not legacy_definitions.exists()
        broker = self.component([self.product / "bin/cornice-desktopd"], "desktop")
        self.info["brokerPid"] = broker.pid
        while time.monotonic() < deadline:
            self.check_request()
            try:
                self.command("desktop", "list")
                break
            except (OSError, RuntimeError, subprocess.SubprocessError):
                time.sleep(.1)
        else:
            raise RuntimeError("Agent desktop service startup timeout")
        self.initialize_desktops(new_installation)
        shell = self.component([self.product / "bin/cornice-qs", "-p", self.product / "shell"], "cornice")
        self.info["shellPid"] = shell.pid
        while time.monotonic() < deadline:
            self.check_request()
            try:
                self.health()
                break
            except (OSError, RuntimeError, ValueError, subprocess.SubprocessError):
                time.sleep(.2)
        else:
            raise RuntimeError("Cornice/Agent desktops failed startup health checks")
        self.mark_ready()
        self.start_ready_auxiliaries()
        # A ready user session ends only on compositor exit or an explicit
        # rollback. Probe errors and bounded component repair stay in place.
        while self.supervise_once():
            time.sleep(.5)

    def cleanup(self):
        # Only process groups created by this supervisor; never terminate-user or pkill Hyprland.
        for child in reversed(self.children):
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        deadline = time.monotonic() + 3
        for child in reversed(self.children):
            try:
                child.wait(timeout=max(.01, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                child.wait()
        for path, device, inode in self.sockets:
            try:
                identity = path.lstat()
                if identity.st_dev == device and identity.st_ino == inode and stat.S_ISSOCK(identity.st_mode):
                    path.unlink()
            except FileNotFoundError:
                pass


def login():
    sandbox = os.environ.get("CORNICE_TEST_SANDBOX") == "1"
    if not sandbox and (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")):
        raise RuntimeError("Refusing to start a login trial inside an existing desktop")
    # Hold the session lock for its whole lifetime; CLI requests use a different lock.
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (STATE / "session.lock").open("a") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        with locked():
            try:
                ticket = login_ticket()
            except (OSError, ValueError) as error:
                atomic(STATE / "current.json", {"status": "rolled-back", "stableSelected": True,
                                                "reason": "Invalid login ticket: " + str(error)})
                return
            if ticket is None:
                if sandbox:
                    return
                os.execv("/usr/bin/start-hyprland", ["/usr/bin/start-hyprland"])
        trial = Trial(ticket)
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            signal.signal(sig, lambda *_: setattr(trial, "interrupted", True))
        manager_environment = None
        normal_end = False
        try:
            verify_release(trial.release)
            # Do not send candidate CORNICE_PATH/PATH into the persistent user manager.
            # The normal service is stopped only at the NEXT login, never by arm/prepare.
            if not sandbox:
                others = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "Hyprland"],
                                        capture_output=True, text=True, timeout=4)
                if others.returncode == 0:
                    raise RuntimeError("Another Hyprland session is still running; refusing to stop its Cornice service")
                names = {"WAYLAND_DISPLAY", "HYPRLAND_INSTANCE_SIGNATURE", "XDG_CURRENT_DESKTOP", "DISPLAY", "CORNICE_PATH", "PATH"}
                previous = dict(line.split("=", 1) for line in run(["systemctl", "--user", "show-environment"]).splitlines() if "=" in line)
                manager_environment = {key: previous.get(key) for key in names}
                atomic(trial.directory / "manager-environment.json", manager_environment)
                run(["systemctl", "--user", "stop", "cornice.service"], timeout=10)
            trial.execute()
            normal_end = trial.info.get("status") == "exited"
        except Exception as error:
            # SIGTERM/HUP after readiness is a normal session end. Explicit
            # rollback has its own durable request and already cleared selection.
            normal_end = (trial.info.get("status") == "exited" or
                          (trial.interrupted and trial.info.get("status") in ("ready", "confirmed") and
                           not (trial.directory / "rollback").exists()))
            trial.update("exited" if normal_end else "rolled-back", reason=str(error))
            print("cornice session ended: " + str(error), file=sys.stderr)
        finally:
            try:
                trial.cleanup()
            finally:
                finish_selection(ticket, normal_end)
            if manager_environment is not None:
                try:
                    present = [key + "=" + value for key, value in manager_environment.items() if value is not None]
                    absent = [key for key, value in manager_environment.items() if value is None]
                    if present:
                        run(["systemctl", "--user", "set-environment", *present])
                    if absent:
                        run(["systemctl", "--user", "unset-environment", *absent])
                except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                    trial.update(trial.info["status"], environmentRestoreError=str(error))
        # Returning success lets SDDM end this session; never auto-login with saved credentials.


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    preparation = sub.add_parser("prepare", help="Snapshot candidate without changing the current desktop")
    preparation.add_argument("--hyprland", required=True)
    preparation.add_argument("--cornice", default=str(ROOT))
    preparation.add_argument("--config", required=True)
    preparation.add_argument("--autostart")
    arming = sub.add_parser("arm", help="Enable exactly one future SDDM Hyprland login")
    arming.add_argument("--seconds", type=int, help="Deprecated and ignored: healthy sessions have no confirmation deadline")
    arming.add_argument("--startup-seconds", type=int, default=60)
    arming.add_argument("--after-current", action="store_true", help="Explicitly select a DIFFERENT candidate for one next login while this trial keeps running")
    choosing = sub.add_parser("select", help="Persistently select a prepared immutable release for future logins")
    choosing.add_argument("--release", help="Prepared release path; defaults to the latest prepared snapshot")
    choosing.add_argument("--startup-seconds", type=int, default=60)
    updating_ui = sub.add_parser("update-ui", help="Update shell QML and its Platform module while preserving the native session")
    updating_ui.add_argument("--release", required=True, help="Prepared immutable UI source release")
    updating_ui.add_argument("--strategy", choices=("soft", "cold"), default="soft",
                             help="soft preserves UI PIDs; cold replaces idle owner-tracked UI processes for legacy/module migration")
    sub.add_parser("rollback-ui", help="Restore previous UI files using the recorded maintenance strategy")
    sub.add_parser("status")
    sub.add_parser("cancel", help="Select stable login by clearing pending and persistent selection; current session unchanged")
    sub.add_parser("remove-hook", help="Cancel and remove only the managed login snippet, keeping other edits")
    sub.add_parser("confirm", help="Optional acknowledgement only; healthy sessions already stay running")
    sub.add_parser("rollback", help="End only the running trial; next login uses the stable version")
    sub.add_parser("login", help=argparse.SUPPRESS)
    detector = sub.add_parser("is-login", help=argparse.SUPPRESS)
    detector.add_argument("pid")
    args = parser.parse_args()
    if args.action == "prepare":
        prepare(args)
    elif args.action == "arm":
        if not 5 <= args.startup_seconds <= 300:
            raise RuntimeError("Startup must be 5..300 seconds")
        arm(args)
    elif args.action == "select":
        if not 5 <= args.startup_seconds <= 300:
            raise RuntimeError("Startup must be 5..300 seconds")
        select_release(args)
    elif args.action == "update-ui":
        update_ui(args)
    elif args.action == "rollback-ui":
        rollback_ui(args)
    elif args.action == "is-login":
        return 0 if login_matches(args.pid) else 1
    elif args.action == "login":
        login()
    elif args.action in ("confirm", "rollback"):
        request(args.action)
    elif args.action in ("cancel", "remove-hook"):
        with locked():
            current = read(STATE / "current.json") if (STATE / "current.json").exists() else {}
            if args.action == "remove-hook" and is_running(current):
                raise RuntimeError("End the trial before removing its login hook")
            cancel_ticket()
            clear_selection()
            if args.action == "remove-hook" and (STATE / "login-profile-backup.json").exists():
                backup = read(STATE / "login-profile-backup.json")
                profile = Path(backup["path"])
                if profile.exists():
                    contents = remove_block(profile.read_text())
                    if not backup["existed"] and not contents:
                        profile.unlink()
                    else:
                        mode = profile.stat().st_mode & 0o777
                        atomic(profile, contents)
                        profile.chmod(mode)
        print("Next login uses the normal stable entry. Current session unchanged.")
    elif args.action == "status":
        current = read(STATE / "current.json") if (STATE / "current.json").exists() else None
        selected, intent, error = next_login()
        print(json.dumps({"armed": (STATE / "pending.json").exists(), "current": current,
                          "running": bool(current and is_running(current)), "selected": selected,
                          "nextLogin": intent, "selectionError": error,
                          "stableSelected": intent["mode"] == "stable"}, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print("cornice session-trial: " + str(error), file=sys.stderr)
        sys.exit(1)
