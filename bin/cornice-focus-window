#!/usr/bin/env bash
# Focus a bar-selected client without pointer warps or leaving the workspace's
# fullscreen/maximized mode. Hyprland executes each batch in one IPC request;
# its two temporary options are restored before the request finishes.
set -euo pipefail
address="${1:-}"
workspace="${2:-}"
[[ $address =~ ^0x[0-9a-fA-F]+$ && $workspace =~ ^-?[0-9]+$ ]] || exit 2
exec 9>"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/cornice-window-focus.lock"
flock -w 2 9 || exit 1
# A queued click must not pull the user back after they change workspaces or
# after the selected window is closed/moved.
[[ $(hyprctl activeworkspace -j | jq -r '.id') == "$workspace" ]] || exit 0
hyprctl clients -j | jq -e --arg address "$address" --argjson workspace "$workspace" \
  'any(.address == $address and .workspace.id == $workspace and .mapped)' >/dev/null || exit 0
warps=$(hyprctl -j getoption cursor:no_warps | jq -er '.int')
under_fullscreen=$(hyprctl -j getoption misc:on_focus_under_fullscreen | jq -er '.int')
[[ $warps =~ ^[01]$ && $under_fullscreen =~ ^[012]$ ]] || exit 1
hyprctl --batch "keyword cursor:no_warps 1; keyword misc:on_focus_under_fullscreen 1; dispatch focuswindow address:$address; keyword misc:on_focus_under_fullscreen $under_fullscreen; keyword cursor:no_warps $warps" >/dev/null
