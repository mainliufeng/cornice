#!/usr/bin/env python3
"""Atomic publication/rollback of a validated Cornice copy installation."""
import argparse
import ctypes
import fcntl
import json
import os
from pathlib import Path
import stat
import tempfile


def identity(path):
    try:
        value = path.lstat()
        return [value.st_dev, value.st_ino]
    except FileNotFoundError:
        return None


def atomic_json(path, value):
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(value, output)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        sync_directory(path.parent)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def sync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def exchange(left, right):
    libc = ctypes.CDLL(None, use_errno=True)
    rename = getattr(libc, "renameat2", None)
    if rename is None:
        raise RuntimeError("atomic update requires Linux renameat2; the old installation is unchanged")
    rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    rename.restype = ctypes.c_int
    if rename(-100, os.fsencode(left), -100, os.fsencode(right), 2):
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    sync_directory(left.parent)


def validate(candidate):
    for name in ("bin/cornice", "shell/shell.qml", "config/default.json", "config/session-services.json"):
        if not (candidate / name).is_file():
            raise RuntimeError("candidate is incomplete: " + name)
    for item in (candidate / "bin").glob("cornice*"):
        if not item.is_file() or not os.access(item, os.X_OK):
            raise RuntimeError("candidate helper is not executable: " + item.name)
    for name in ("config/default.json", "config/session-services.json"):
        with (candidate / name).open() as source:
            json.load(source)
    if (candidate / "native/bin/cornice-desktop-runtime").exists():
        for name in ("cornice-browser-runtime", "cornice-native-accessibility", "cornice-human-lock", "cornice-session-guard"):
            helper = candidate / "native/bin" / name
            if not helper.is_file() or not os.access(helper, os.X_OK):
                raise RuntimeError("desktop candidate is incomplete: " + name)
    # Flush only this candidate, never the user's other filesystems.
    for directory, _, files in os.walk(candidate):
        for name in files:
            path = Path(directory) / name
            if not stat.S_ISREG(path.lstat().st_mode):
                continue
            with path.open("rb") as source:
                os.fsync(source.fileno())
        sync_directory(Path(directory))


def reconcile_links(target):
    bindir = target.parent.parent / "bin"
    bindir.mkdir(parents=True, exist_ok=True)
    names = set()
    for source in (target / "bin").glob("cornice*"):
        names.add(source.name)
        temporary = bindir / ("." + source.name + ".install")
        if temporary.is_symlink():
            temporary.unlink()
        temporary.symlink_to(source)
        os.replace(temporary, bindir / source.name)
    for item in bindir.glob("cornice*"):
        if item.is_symlink() and item.name not in names and item.readlink() == target / "bin" / item.name:
            item.unlink()
    sync_directory(bindir)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("activate", "rollback", "status"))
    parser.add_argument("target", type=Path)
    parser.add_argument("candidate", type=Path, nargs="?")
    parser.add_argument("--if-activated", type=Path, help="rollback only the named attempted activation")
    args = parser.parse_args()
    target = args.target.absolute()
    target.parent.mkdir(parents=True, exist_ok=True)
    journal = target.parent / ("." + target.name + "-install.json")
    with (target.parent / ("." + target.name + "-install.lock")).open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        previous = json.loads(journal.read_text()) if journal.exists() else None
        if args.operation == "activate":
            if args.candidate is None:
                parser.error("activate needs a candidate")
            candidate = args.candidate.absolute()
            if candidate.parent != target.parent or candidate == target or candidate.is_symlink():
                raise RuntimeError("candidate must be a separate real tree beside the install target")
            validate(candidate)
            old = identity(target)
            # Interrupted unpublished transactions must not displace the last
            # journal that actually describes the currently installed inode.
            applicable = previous
            while applicable and applicable["activeIdentity"] != old:
                applicable = applicable.get("fallback")
            next_state = {"schema": 1, "target": str(target), "candidate": str(candidate),
                          "activeIdentity": identity(candidate), "previousIdentity": old,
                          "fallback": {key: value for key, value in applicable.items() if key != "fallback"} if applicable else None}
            # Journal before exchange: recovery can distinguish a staged update
            # from an activated one even after an uncatchable power/process loss.
            atomic_json(journal, next_state)
            if old is None:
                os.replace(candidate, target)
                sync_directory(target.parent)
            else:
                exchange(candidate, target)
            print(json.dumps({"active": str(target), "previous": str(candidate) if old else None}))
        elif args.operation == "rollback":
            if args.if_activated is not None and (not previous or
                    previous["candidate"] != str(args.if_activated.absolute()) or
                    identity(target) != previous["activeIdentity"]):
                # A failure before activation must not roll back an unrelated,
                # already installed generation from an older transaction.
                print(json.dumps({"active": str(target), "rollback": "not-activated"}))
                return
            if previous and previous.get("operation") == "rollback" and previous.get("pending"):
                candidate = Path(previous["candidate"])
                current, backup = identity(target), identity(candidate)
                if current == previous["previousIdentity"] and backup == previous["activeIdentity"]:
                    exchange(target, candidate)
                elif current != previous["activeIdentity"] or backup != previous["previousIdentity"]:
                    raise RuntimeError("interrupted rollback identities changed; refusing unrelated files")
                # A crash after exchange resumes link repair without toggling
                # the restored generation back to the broken one.
                reconcile_links(target)
                previous["pending"] = False
                atomic_json(journal, previous)
                print(json.dumps({"active": str(target), "previous": str(candidate), "recovered": True}))
                return
            state = previous
            while state and identity(target) != state["activeIdentity"]:
                state = state.get("fallback")
            if not state or not state.get("previousIdentity"):
                raise RuntimeError("no previous installed generation is available")
            candidate = Path(state["candidate"])
            if identity(candidate) != state["previousIdentity"]:
                raise RuntimeError("previous generation changed; refusing to replace unrelated files")
            next_state = {key: value for key, value in state.items() if key != "fallback"}
            next_state.update(operation="rollback", pending=True,
                              activeIdentity=state["previousIdentity"],
                              previousIdentity=state["activeIdentity"],
                              fallback={key: value for key, value in state.items() if key != "fallback"})
            atomic_json(journal, next_state)
            exchange(target, candidate)
            reconcile_links(target)
            next_state["pending"] = False
            atomic_json(journal, next_state)
            print(json.dumps({"active": str(target), "previous": str(candidate)}))
        else:
            print(json.dumps({"active": str(target), "identity": identity(target), "transaction": previous}))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError) as error:
        raise SystemExit("cornice install: " + str(error))
