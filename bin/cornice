#!/usr/bin/env bash
# cornice — talk to the running Cornice shell.
#
# The shell is its own long-running process; this CLI never starts it (except
# for `launch`, `restart` and `start`). Every other command forwards an IPC
# call and fails loudly when no shell is running.
set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
bin_dir=$(dirname "$self")
prefix="${CORNICE_PATH:-$(cd "$bin_dir/.." && pwd)}"
export CORNICE_PATH="$prefix"

qs="$bin_dir/cornice-qs"
config_dir="$prefix/shell"

usage() {
  cat <<'USAGE'
Usage: cornice <command> [args...]

Shell lifecycle
  launch              Start the shell in the foreground (watchdog loops)
  start               Start the shell in the background
  restart             Kill every instance of this config and start a fresh one
  stop                Kill every instance of this config
  status              Is a shell running, and what does it answer?

Inspecting the running shell (IPC)
  ping                Health check
  version             Shell version
  plugins             Installed plugins
  widgets             Available bar widgets
  config              Effective configuration (defaults merged with yours)
  theme [list|toggle|<name>]   Show, list, cycle or set the theme (persisted)
  language [list|<code>]       Show, list or set the UI language (persisted)
  reload              Re-read config.json and theme.json
  reload-plugins      Re-scan the plugin directories
  ipc <target> <fn>   Raw IPC call, e.g. cornice ipc shell ping
  targets             IPC targets the running shell exposes
  panel <id> [json]   Toggle a panel plugin (e.g. cornice panel cn.audio)
  launcher            Toggle the application launcher
  screenshot [mode] [path]   Native region (default) or screen capture; optional absolute PNG path
  clipboard           Toggle the clipboard history overlay
  background [cmd]    Wallpaper layer: status | set <path> | next | prev | clear | reload
  emojis              Toggle the emoji picker
  notifications       Toggle the notification centre
  dnd [on|off]        Toggle or set do-not-disturb
  osd <what>          volume | microphone | brightness | hide
  lock [cmd]          daily lock; full; recover; status; emergency-unlock (stuck session)
  logs                Follow the shell's journal (systemd only)

Machine
  suspend             Confirm a full session lock before sleeping
  doctor              Check dependencies, compositor and conflicts
  health              Print the health report saved at the last shell start
  verify              Check the running shell inside your real session
  bar [cmd]           Bar layout: list | show <id> | hide <id> | move <id> up|down|… | edit
  weather [cmd]       Places: list | add <name> [--city C] | set | rename | remove | move | select
  clock [cmd]         World clocks: list | add <name> <zone> | set | rename | remove | move | zones
  previews [mode]     Floating previews: active (default) | always
  desktop [cmd]       Independent seat-bound desktops (desktop help)
  session-trial [cmd] One-shot login trial with automatic fallback (session-trial --help)
  takeover [--apply]  Take over from mako/hypridle/waybar/polkit-gnome (plan first!)
  test [--quick|suite]  Run the test suites (takeover, headless, lock, live)
  session-env         Print compositor env exports (for TTYs / stale shells)
  path                Print the paths cornice resolved
  help                This message
USAGE
}

# Qt's IPC client waits forever when a shell is starting or wedged; every call
# here is bounded so the CLI can never hang a script that uses it.
ipc_timeout="${CORNICE_IPC_TIMEOUT:-5}"

# A compositor shortcut carries its input seat. It must address that seat's
# shell, just like a command started by the shell itself. A missing scoped
# socket is an error; Quickshell's config-wide discovery can select another seat.
shell_desktop="${CORNICE_DESKTOP_NAME:-}"
if [[ -n ${HYPRLAND_SEAT_ID:-} ]]; then
  shell_desktop="${HYPRLAND_SEAT_NAME:-}"
fi
# Services declare their lifetime once; the CLI and shell both read this table.
# An invalid/missing table must not turn a session action into a desktop action.
target_scope() {
  local scope
  scope=$(jq -er --arg target "$1" '
    .services as $services |
    if ($services | type) != "array" or
       any($services[]; (.id | type) != "string" or .id == "" or
           (.scope != "session" and .scope != "desktop") or
           (.targets | type) != "array" or any(.targets[]; type != "string" or . == "")) or
       ([$services[].id] | length) != ([$services[].id] | unique | length) or
       ([$services[].targets[]] | length) != ([$services[].targets[]] | unique | length)
    then error("invalid service scope declaration") else
      [$services[] | select(.targets | index($target)) | .scope] |
      if length == 0 then "desktop" elif length == 1 then .[0]
      else error("ambiguous IPC target scope") end
    end' "$prefix/config/session-services.json" 2>/dev/null) || {
      echo "cornice: invalid or missing service scope declaration" >&2
      return 2
    }
  printf '%s\n' "$scope"
}

runtime_dir() {
  local dir="${XDG_RUNTIME_DIR:-}"
  if [[ -z $dir && -d /run/user/$(id -u) ]]; then dir="/run/user/$(id -u)"; fi
  printf '%s\n' "${dir:-/tmp}"
}

primary_endpoint_path() {
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 2
  local instance_digest
  instance_digest=$(printf '%s' "$HYPRLAND_INSTANCE_SIGNATURE" | sha256sum)
  printf '%s/cs-%.8s-session.json\n' "$(runtime_dir)" "$instance_digest"
}

primary_socket_path() {
  if [[ -n ${CORNICE_PRIMARY_SHELL_SOCKET:-} ]]; then
    printf '%s\n' "$CORNICE_PRIMARY_SHELL_SOCKET"; return
  fi
  # Hyprland's exec environment cannot inherit a running shell's custom socket.
  # The primary shell publishes its endpoint for those native shortcuts.
  local endpoint sock
  endpoint=$(primary_endpoint_path) || endpoint=""
  if [[ -n $endpoint && -f $endpoint ]]; then
    sock=$(jq -er '.socket | select(type == "string" and startswith("/"))' "$endpoint" 2>/dev/null) || {
      echo "cornice: invalid primary shell endpoint" >&2; return 2
    }
    printf '%s\n' "$sock"; return
  fi
  # Legacy sessions without an instance may explicitly configure their socket.
  # With an instance, a socket-only caller can also be a secondary shell.
  if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} && -z $shell_desktop && -n ${CORNICE_SHELL_SOCKET:-} ]]; then
    printf '%s\n' "$CORNICE_SHELL_SOCKET"; return
  fi
  printf '%s/cornice-%s.sock\n' "$(runtime_dir)" "${USER:-user}"
}

scoped_shell() {
  [[ ${1:-desktop} == session || -n $shell_desktop ||
     -n ${CORNICE_SHELL_SOCKET:-} || -n ${CORNICE_PRIMARY_SHELL_SOCKET:-} ]] && return 0
  local endpoint
  endpoint=$(primary_endpoint_path) || return 1
  [[ -f $endpoint ]]
}

validate_native_seat() {
  [[ -n ${HYPRLAND_SEAT_ID:-} ]] || return 0
  local state
  if [[ -z $shell_desktop || -z ${HYPRLAND_SEAT_GENERATION:-} ]] ||
     ! state=$(timeout "$ipc_timeout" hyprctl -j seat state "$shell_desktop" 2>/dev/null) ||
     ! jq -e --arg id "$HYPRLAND_SEAT_ID" --arg generation "$HYPRLAND_SEAT_GENERATION" \
         '.seatId == $id and (.generation | tostring) == $generation' <<<"$state" >/dev/null 2>&1; then
    echo "cornice: stale or unavailable native seat: $shell_desktop" >&2
    return 2
  fi
}

shell_running() {
  local status
  call_via_socket desktop shell ping >/dev/null 2>&1
  status=$?
  ((status == 0)) && return 0
  scoped_shell && return "$status"
  timeout "$ipc_timeout" "$qs" ipc -p "$config_dir" call shell ping >/dev/null 2>&1
}

require_shell() {
  if ! shell_running; then
    echo "cornice: no running shell for $config_dir" >&2
    echo "  start it with: cornice start   (or: cornice launch)" >&2
    exit 1
  fi
}

# Request framing for the shell's own socket, matching services/IpcServer.qml.
socket_path() {
  if [[ ${1:-desktop} == session ]]; then primary_socket_path; return; fi
  if [[ -n $shell_desktop ]]; then
    [[ $shell_desktop =~ ^[a-zA-Z0-9_-]+$ ]] || return 2
    local instance_digest
    instance_digest=$(printf '%s' "${HYPRLAND_INSTANCE_SIGNATURE:?}" | sha256sum)
    printf '%s/cs-%.8s-%s.sock\n' "${XDG_RUNTIME_DIR:?}" "$instance_digest" "$shell_desktop"
    return
  fi
  if [[ -n ${CORNICE_SHELL_SOCKET:-} ]]; then printf '%s\n' "$CORNICE_SHELL_SOCKET"; return; fi
  primary_socket_path
}

call_via_socket() {
  local sock target method scope=$1
  shift
  sock=$(socket_path "$scope") || return 4
  [[ -S $sock ]] || return 2
  command -v socat >/dev/null 2>&1 || return 2
  command -v jq >/dev/null 2>&1 || return 2

  target=$1
  method=$2
  shift 2
  # Keep each argv element intact, including empty or multiline arguments.
  local args
  args=$(jq -cn --args '$ARGS.positional' -- "$@")
  local request
  request=$(jq -cn --arg t "$target" --arg m "$method" --argjson a "$args" '{target:$t, method:$m, args:$a}')

  local reply
  reply=$(printf '%s\n' "$request" | timeout "$ipc_timeout" socat - UNIX-CONNECT:"$sock" 2>/dev/null) || return 3
  if jq -e '.ok == true' <<<"$reply" >/dev/null 2>&1; then
    jq -r '.result' <<<"$reply"
    return 0
  fi
  echo "cornice: $(jq -r '.error // "request failed"' <<<"$reply")" >&2
  return 1
}

call() {
  local status=0 scope
  scope=$(target_scope "$1") || return 2
  if [[ $scope == desktop ]]; then validate_native_seat || return 2; fi
  call_via_socket "$scope" "$@" || status=$?
  ((status == 0)) && return 0
  ((status == 1 || status == 4)) && return "$status"

  if scoped_shell "$scope"; then
    echo "cornice: no responding $scope shell at $(socket_path "$scope")" >&2
    return "$status"
  fi
  require_shell
  timeout "$ipc_timeout" "$qs" ipc -p "$config_dir" call "$@"
}

command="${1:-help}"
shift || true

case "$command" in
  help | -h | --help)
    usage
    ;;

  ping)
    call shell ping
    ;;

  version)
    call shell version
    ;;

  plugins)
    call shell plugins
    ;;

  widgets)
    call shell widgets
    ;;

  config)
    call shell config
    ;;

  language)
    lang_dir="$prefix/i18n"
    available_languages() { ls -1 "$lang_dir"/*.json 2>/dev/null | sed 's|.*/||; s|\.json$||' | sort; }

    persist_language() {
      local code=$1 config="${XDG_CONFIG_HOME:-$HOME/.config}/cornice/config.json"
      mkdir -p "$(dirname "$config")"
      [[ -f $config ]] || echo '{}' >"$config"
      local tmp
      tmp=$(mktemp)
      jq --arg l "$code" '.language = $l' "$config" >"$tmp" && mv "$tmp" "$config"
    }

    case "${1:-}" in
      "")
        call i18n status 2>/dev/null | jq -r '.language // "en"'
        ;;
      list)
        available_languages
        ;;
      *)
        code="$1"
        if ! available_languages | grep -qx "$code"; then
          echo "cornice: no translations for '$code' (available: $(available_languages | tr '\n' ' '))" >&2
          exit 1
        fi
        persist_language "$code"
        call shell reloadConfig >/dev/null 2>&1 || timeout 5 "$qs" ipc -p "$config_dir" call shell reloadConfig >/dev/null 2>&1 || true
        echo "$code"
        ;;
    esac
    ;;

  theme)
    theme_dir="$prefix/themes"
    available_themes() { ls -1 "$theme_dir" 2>/dev/null | sort; }
    current_theme() { call shell theme 2>/dev/null || echo ""; }

    persist_theme() {
      local name=$1 config="${XDG_CONFIG_HOME:-$HOME/.config}/cornice/config.json"
      mkdir -p "$(dirname "$config")"
      [[ -f $config ]] || echo '{}' >"$config"
      local tmp
      tmp=$(mktemp)
      jq --arg t "$name" '.theme = $t' "$config" >"$tmp" && mv "$tmp" "$config"
    }

    case "${1:-}" in
      "")
        current_theme
        ;;
      list)
        available_themes
        ;;
      toggle)
        # Cycle through the installed themes and remember the choice, so a
        # keybinding can flip the whole desktop between light and dark.
        mapfile -t names < <(available_themes)
        if ((${#names[@]} == 0)); then echo "cornice: no themes installed" >&2; exit 1; fi
        current=$(current_theme)
        next="${names[0]}"
        for i in "${!names[@]}"; do
          if [[ ${names[$i]} == "$current" ]]; then next="${names[$(( (i + 1) % ${#names[@]} ))]}"; break; fi
        done
        persist_theme "$next"
        call shell setTheme "$next" >/dev/null
        echo "$next"
        ;;
      *)
        persist_theme "$1"
        call shell setTheme "$1"
        ;;
    esac
    ;;

  previews)
    . "$bin_dir/cornice-config.sh"
    case "${1:-}" in
      "") cornice_config_raw | jq -r 'if .agentDesktop.alwaysShowPreviews == true then "always" else "active" end' ;;
      active|always)
        enabled=false; [[ $1 == always ]] && enabled=true
        cornice_config_edit '.agentDesktop = ((.agentDesktop // {}) + {alwaysShowPreviews: $enabled})' --argjson enabled "$enabled"
        ;;
      size)
        (($# == 3)) && [[ $2 =~ ^[0-9]+$ && $3 =~ ^[0-9]+$ ]] && ((10#$2 >= 240 && 10#$2 <= 1600 && 10#$3 >= 160 && 10#$3 <= 1000)) || { echo 'usage: cornice previews size <width:240-1600> <card-height:160-1000>' >&2; exit 2; }
        cornice_config_edit '.agentDesktop = ((.agentDesktop // {}) + {previewWidth: $width, previewCardHeight: $height})' --argjson width "$2" --argjson height "$3"
        ;;
      *) echo 'usage: cornice previews [active|always|size <width> <card-height>]' >&2; exit 2 ;;
    esac
    ;;

  reload)
    call shell reloadConfig
    ;;

  reload-plugins)
    call shell reloadPlugins
    ;;

  ipc)
    (($# >= 2)) || { echo "usage: cornice ipc <target> <function> [args...]" >&2; exit 2; }
    call "$@"
    ;;

  targets)
    call shell targets
    ;;

  socket)
    call shell socket
    ;;

  panel)
    (($# >= 1)) || { echo "usage: cornice panel <plugin-id> [payload-json]" >&2; exit 2; }
    call shell toggle "$1" "${2:-{\}}"
    ;;

  launcher)
    call shell toggle cn.launcher '{}'
    ;;

  screenshot)
    mode=${1:-region}
    [[ $mode == region || $mode == screen ]] && (($# <= 2)) && [[ ${2:-/} == /* ]] || { echo 'usage: cornice screenshot [region|screen] [absolute-png-path]' >&2; exit 2; }
    result=$(call screenshot capture "$mode" "${2:-}")
    [[ $result == requested ]] || { echo "cornice: screenshot: $result" >&2; exit 1; }
    printf '%s\n' "$result"
    ;;

  notifications)
    call shell toggle cn.notifications '{}'
    ;;

  clipboard)
    call shell toggle cn.clipboard '{}'
    ;;

  background | wallpaper)
    (($# >= 1)) || { echo "usage: cornice background status|set <path>|next|prev|clear|reload" >&2; exit 2; }
    call background "$@"
    ;;

  emojis)
    call shell toggle cn.emojis '{}'
    ;;

  dnd)
    if (($# == 1)); then call notifications setDnd "$1"; else call notifications toggleDnd; fi
    ;;

  osd)
    (($# >= 1)) || { echo "usage: cornice osd volume|microphone|brightness|hide" >&2; exit 2; }
    call osd "$1"
    ;;

  suspend)
    result=$(call idle suspend)
    case "$result" in
      requested) printf '%s\n' "$result" ;;
      full-lock-required)
        for ((attempt=0; attempt<50; attempt++)); do
          if call lock status | jq -e '.secure == true' >/dev/null; then exec systemctl suspend; fi
          sleep 0.1
        done
        echo 'cornice: full lock was not confirmed; sleep refused' >&2; exit 1 ;;
      *) echo "cornice: sleep refused: $result" >&2; exit 1 ;;
    esac
    ;;
  lock)
    case "${1:-lock}" in
      lock) call lock lock ;;
      full) call lock full ;;
      recover) call lock recover ;;
      status) call lock status ;;
      try) (($# >= 2)) || { echo "usage: cornice lock try <password>" >&2; exit 2; }; call lock attempt "$2" ;;
      emergency-unlock)
        echo "cornice: releasing the session lock WITHOUT authentication" >&2
        call lock emergencyUnlock
        ;;
      *)
        echo "usage: cornice lock [lock|full|recover|status|try <password>|emergency-unlock]" >&2
        exit 2
        ;;
    esac
    ;;

  launch)
    exec "$bin_dir/cornice-launch"
    ;;

  start)
    setsid "$bin_dir/cornice-launch" >/dev/null 2>&1 &
    disown || true
    for _ in $(seq 1 50); do
      if shell_running; then
        echo "cornice: shell running"
        exit 0
      fi
      sleep 0.1
    done
    echo "cornice: shell did not answer after 5s — check: journalctl --user -t cornice -n 50" >&2
    exit 1
    ;;

  restart)
    exec "$bin_dir/cornice-restart"
    ;;

  stop)
    # Killing the shell while the session is locked kills the lock client too:
    # Hyprland then shows its crashed-lockscreen failsafe, and on a hyprlang
    # config there is no runtime command to clear it (hl.clear_crashed_lockscreen
    # is Lua-only). So refuse unless the caller insists.
    if [[ ${1:-} != "--force" ]] && timeout 3 "$qs" ipc -p "$config_dir" call lock status 2>/dev/null | grep -q '"secure":true'; then
      echo "cornice: the session is locked — stopping the shell now would leave Hyprland's" >&2
      echo "  crashed-lockscreen failsafe up (only a session restart clears it on a hyprlang config)." >&2
      echo "  unlock first, or pass --force if you really mean it." >&2
      exit 1
    fi
    # Tell the watchdog this stop is deliberate (it relaunches after any other
    # exit, including a clean one).
    stop_marker="${XDG_RUNTIME_DIR:-/tmp}/cornice-stop"
    mkdir -p "$(dirname "$stop_marker")" 2>/dev/null || true
    : >"$stop_marker"
    stopped=0
    while "$qs" kill -p "$config_dir" --any-display >/dev/null 2>&1; do
      stopped=1
    done
    if ((stopped)); then echo "cornice: shell stopped"; else
      echo "cornice: no shell was running"
      rm -f "$stop_marker"
    fi
    ;;

  status)
    if shell_running; then
      echo "running: $(call shell ping)"
    else
      echo "not running (config: $config_dir)"
    fi
    ;;

  logs)
    journalctl --user -t cornice -f
    ;;

  doctor)
    exec "$bin_dir/cornice-doctor" "$@"
    ;;

  verify)
    exec "$bin_dir/cornice-verify" "$@"
    ;;

  bar)
    exec "$bin_dir/cornice-bar" "$@"
    ;;

  weather)
    exec "$bin_dir/cornice-weather" "$@"
    ;;

  clock)
    exec "$bin_dir/cornice-clock" "$@"
    ;;

  desktop)
    exec "$bin_dir/cornice-desktop" "$@"
    ;;

  session-trial)
    exec "$bin_dir/cornice-session-trial" "$@"
    ;;

  takeover)
    exec "$bin_dir/cornice-takeover" "$@"
    ;;

  test)
    exec "$bin_dir/cornice-test" "$@"
    ;;

  session-env)
    exec "$bin_dir/cornice-env.sh"
    ;;

  health)
    report="${XDG_STATE_HOME:-$HOME/.local/state}/cornice/doctor-last.txt"
    if [[ -f $report ]]; then
      echo "# $report"
      cat "$report"
    else
      echo "cornice: no saved health report yet (it is written on the next shell start)"
      echo "  run it now: cornice doctor"
    fi
    ;;

  path)
    if [[ ${1:-} == --json && $# == 1 ]]; then
      # Read-only endpoint resolution for UI clients, including older Brokers.
      # No shell health call or compositor input authorization is consumed.
      target_scope shell >/dev/null || exit 2
      local_socket=$(socket_path) || exit 2
      primary_socket=$(primary_socket_path) || exit 2
      jq -cn --arg prefix "$prefix" --arg config "$config_dir" \
        --arg userConfig "${XDG_CONFIG_HOME:-$HOME/.config}/cornice/config.json" \
        --arg socket "$local_socket" --arg primarySocket "$primary_socket" \
        '{prefix:$prefix,configDir:$config,userConfig:$userConfig,socket:$socket,primarySocket:$primarySocket}'
    elif (($# == 0)); then
      printf 'prefix:     %s\n' "$prefix"
      printf 'config dir: %s\n' "$config_dir"
      printf 'user config: %s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/cornice/config.json"
      printf 'socket:     %s\n' "$(socket_path)"
      printf 'quickshell:  %s\n' "$("$qs" --version 2>/dev/null | head -1)"
    else
      echo 'usage: cornice path [--json]' >&2; exit 2
    fi
    ;;

  *)
    echo "cornice: unknown command '$command'" >&2
    usage >&2
    exit 2
    ;;
esac
