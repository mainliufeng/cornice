#!/usr/bin/env bash
# cornice — talk to the running Cornice shell.
#
# The shell is its own long-running process; this CLI never starts it (except
# for `launch`, `restart` and `start`). Every other command forwards an IPC
# call and fails loudly when no shell is running.
set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
bin_dir=$(dirname "$self")
prefix="${CORNICE_PATH:-$(cd "$bin_dir/.." && pwd)}"
export CORNICE_PATH="$prefix"

qs="$bin_dir/cornice-qs"
config_dir="$prefix/shell"

usage() {
  cat <<'USAGE'
Usage: cornice <command> [args...]

Shell lifecycle
  launch              Start the shell in the foreground (watchdog loops)
  start               Start the shell in the background
  restart             Kill every instance of this config and start a fresh one
  stop                Kill every instance of this config
  status              Is a shell running, and what does it answer?

Inspecting the running shell (IPC)
  ping                Health check
  version             Shell version
  plugins             Installed plugins
  widgets             Available bar widgets
  config              Effective configuration (defaults merged with yours)
  theme [list|toggle|<name>]   Show, list, cycle or set the theme (persisted)
  reload              Re-read config.json and theme.json
  reload-plugins      Re-scan the plugin directories
  ipc <target> <fn>   Raw IPC call, e.g. cornice ipc shell ping
  targets             IPC targets the running shell exposes
  panel <id> [json]   Toggle a panel plugin (e.g. cornice panel cn.audio)
  launcher            Toggle the application launcher
  clipboard           Toggle the clipboard history overlay
  background [cmd]    Wallpaper layer: status | set <path> | next | prev | clear | reload
  emojis              Toggle the emoji picker
  notifications       Toggle the notification centre
  dnd [on|off]        Toggle or set do-not-disturb
  osd <what>          volume | microphone | brightness | hide
  lock [cmd]          lock now; status; try <password>; emergency-unlock (stuck session)
  logs                Follow the shell's journal (systemd only)

Machine
  doctor              Check dependencies, compositor and conflicts
  health              Print the health report saved at the last shell start
  verify              Check the running shell inside your real session
  bar [cmd]           Bar layout: list | show <id> | hide <id> | move <id> up|down|… | edit
  takeover [--apply]  Take over from mako/hypridle/waybar/polkit-gnome (plan first!)
  test [--quick|suite]  Run the test suites (takeover, headless, lock, live)
  session-env         Print compositor env exports (for TTYs / stale shells)
  path                Print the paths cornice resolved
  help                This message
USAGE
}

# Qt's IPC client waits forever when a shell is starting or wedged; every call
# here is bounded so the CLI can never hang a script that uses it.
ipc_timeout="${CORNICE_IPC_TIMEOUT:-5}"

shell_running() {
  local status
  call_via_socket shell ping >/dev/null 2>&1
  status=$?
  ((status == 0)) && return 0
  timeout "$ipc_timeout" "$qs" ipc -p "$config_dir" call shell ping >/dev/null 2>&1
}

require_shell() {
  if ! shell_running; then
    echo "cornice: no running shell for $config_dir" >&2
    echo "  start it with: cornice start   (or: cornice launch)" >&2
    exit 1
  fi
}

# Request framing for the shell's own socket, matching services/IpcServer.qml.
socket_path() {
  # A TTY (where the emergency unlock is used from) has no XDG_RUNTIME_DIR, so
  # fall back to the user's own runtime dir before /tmp.
  local dir="${XDG_RUNTIME_DIR:-}"
  if [[ -z $dir && -d /run/user/$(id -u) ]]; then dir="/run/user/$(id -u)"; fi
  printf '%s/cornice-%s.sock\n' "${dir:-/tmp}" "${USER:-user}"
}

call_via_socket() {
  local sock target method
  sock=$(socket_path)
  [[ -S $sock ]] || return 2
  command -v socat >/dev/null 2>&1 || return 2
  command -v jq >/dev/null 2>&1 || return 2

  target=$1
  method=$2
  shift 2
  # Missing --jq args: build the array from the remaining argv.
  local args='[]'
  if (($#)); then
    args=$(printf '%s\n' "$@" | jq -Rs 'split("\n") | .[0:length-1]')
  fi
  local request
  request=$(jq -cn --arg t "$target" --arg m "$method" --argjson a "$args" '{target:$t, method:$m, args:$a}')

  local reply
  reply=$(printf '%s\n' "$request" | timeout "$ipc_timeout" socat - UNIX-CONNECT:"$sock" 2>/dev/null) || return 3
  if jq -e '.ok == true' <<<"$reply" >/dev/null 2>&1; then
    jq -r '.result' <<<"$reply"
    return 0
  fi
  echo "cornice: $(jq -r '.error // "request failed"' <<<"$reply")" >&2
  return 1
}

call() {
  local status
  call_via_socket "$@"
  status=$?
  ((status == 0)) && return 0
  ((status == 1)) && return 1

  require_shell
  timeout "$ipc_timeout" "$qs" ipc -p "$config_dir" call "$@"
}

command="${1:-help}"
shift || true

case "$command" in
  help | -h | --help)
    usage
    ;;

  ping)
    call shell ping
    ;;

  version)
    call shell version
    ;;

  plugins)
    call shell plugins
    ;;

  widgets)
    call shell widgets
    ;;

  config)
    call shell config
    ;;

  theme)
    theme_dir="$prefix/themes"
    available_themes() { ls -1 "$theme_dir" 2>/dev/null | sort; }
    current_theme() { call shell theme 2>/dev/null || echo ""; }

    persist_theme() {
      local name=$1 config="${XDG_CONFIG_HOME:-$HOME/.config}/cornice/config.json"
      mkdir -p "$(dirname "$config")"
      [[ -f $config ]] || echo '{}' >"$config"
      local tmp
      tmp=$(mktemp)
      jq --arg t "$name" '.theme = $t' "$config" >"$tmp" && mv "$tmp" "$config"
    }

    case "${1:-}" in
      "")
        current_theme
        ;;
      list)
        available_themes
        ;;
      toggle)
        # Cycle through the installed themes and remember the choice, so a
        # keybinding can flip the whole desktop between light and dark.
        mapfile -t names < <(available_themes)
        if ((${#names[@]} == 0)); then echo "cornice: no themes installed" >&2; exit 1; fi
        current=$(current_theme)
        next="${names[0]}"
        for i in "${!names[@]}"; do
          if [[ ${names[$i]} == "$current" ]]; then next="${names[$(( (i + 1) % ${#names[@]} ))]}"; break; fi
        done
        persist_theme "$next"
        call shell setTheme "$next" >/dev/null
        echo "$next"
        ;;
      *)
        persist_theme "$1"
        call shell setTheme "$1"
        ;;
    esac
    ;;

  reload)
    call shell reloadConfig
    ;;

  reload-plugins)
    call shell reloadPlugins
    ;;

  ipc)
    (($# >= 2)) || { echo "usage: cornice ipc <target> <function> [args...]" >&2; exit 2; }
    call "$@"
    ;;

  targets)
    call shell targets
    ;;

  socket)
    call shell socket
    ;;

  panel)
    (($# >= 1)) || { echo "usage: cornice panel <plugin-id> [payload-json]" >&2; exit 2; }
    call shell toggle "$1" "${2:-{\}}"
    ;;

  launcher)
    call shell toggle cn.launcher '{}'
    ;;

  notifications)
    call shell toggle cn.notifications '{}'
    ;;

  clipboard)
    call shell toggle cn.clipboard '{}'
    ;;

  background | wallpaper)
    (($# >= 1)) || { echo "usage: cornice background status|set <path>|next|prev|clear|reload" >&2; exit 2; }
    call background "$@"
    ;;

  emojis)
    call shell toggle cn.emojis '{}'
    ;;

  dnd)
    (($# == 1)) && call notifications setDnd "$1" || call notifications toggleDnd
    ;;

  osd)
    (($# >= 1)) || { echo "usage: cornice osd volume|microphone|brightness|hide" >&2; exit 2; }
    call osd "$1"
    ;;

  lock)
    case "${1:-lock}" in
      lock) call lock lock ;;
      status) call lock status ;;
      try) (($# >= 2)) || { echo "usage: cornice lock try <password>" >&2; exit 2; }; call lock attempt "$2" ;;
      emergency-unlock)
        echo "cornice: releasing the session lock WITHOUT authentication" >&2
        call lock emergencyUnlock
        ;;
      *)
        echo "usage: cornice lock [lock|status|try <password>|emergency-unlock]" >&2
        exit 2
        ;;
    esac
    ;;

  launch)
    exec "$bin_dir/cornice-launch"
    ;;

  start)
    setsid "$bin_dir/cornice-launch" >/dev/null 2>&1 &
    disown || true
    for _ in $(seq 1 50); do
      if shell_running; then
        echo "cornice: shell running"
        exit 0
      fi
      sleep 0.1
    done
    echo "cornice: shell did not answer after 5s — check: journalctl --user -t cornice -n 50" >&2
    exit 1
    ;;

  restart)
    exec "$bin_dir/cornice-restart"
    ;;

  stop)
    # Killing the shell while the session is locked kills the lock client too:
    # Hyprland then shows its crashed-lockscreen failsafe, and on a hyprlang
    # config there is no runtime command to clear it (hl.clear_crashed_lockscreen
    # is Lua-only). So refuse unless the caller insists.
    if [[ ${1:-} != "--force" ]] && timeout 3 "$qs" ipc -p "$config_dir" call lock status 2>/dev/null | grep -q '"secure":true'; then
      echo "cornice: the session is locked — stopping the shell now would leave Hyprland's" >&2
      echo "  crashed-lockscreen failsafe up (only a session restart clears it on a hyprlang config)." >&2
      echo "  unlock first, or pass --force if you really mean it." >&2
      exit 1
    fi
    # Tell the watchdog this stop is deliberate (it relaunches after any other
    # exit, including a clean one).
    stop_marker="${XDG_RUNTIME_DIR:-/tmp}/cornice-stop"
    mkdir -p "$(dirname "$stop_marker")" 2>/dev/null || true
    : >"$stop_marker"
    stopped=0
    while "$qs" kill -p "$config_dir" --any-display >/dev/null 2>&1; do
      stopped=1
    done
    if ((stopped)); then echo "cornice: shell stopped"; else
      echo "cornice: no shell was running"
      rm -f "$stop_marker"
    fi
    ;;

  status)
    if shell_running; then
      echo "running: $("$qs" ipc -p "$config_dir" call shell ping)"
    else
      echo "not running (config: $config_dir)"
    fi
    ;;

  logs)
    journalctl --user -t cornice -f
    ;;

  doctor)
    exec "$bin_dir/cornice-doctor" "$@"
    ;;

  verify)
    exec "$bin_dir/cornice-verify" "$@"
    ;;

  bar)
    exec "$bin_dir/cornice-bar" "$@"
    ;;

  takeover)
    exec "$bin_dir/cornice-takeover" "$@"
    ;;

  test)
    exec "$bin_dir/cornice-test" "$@"
    ;;

  session-env)
    exec "$bin_dir/cornice-env.sh"
    ;;

  health)
    report="${XDG_STATE_HOME:-$HOME/.local/state}/cornice/doctor-last.txt"
    if [[ -f $report ]]; then
      echo "# $report"
      cat "$report"
    else
      echo "cornice: no saved health report yet (it is written on the next shell start)"
      echo "  run it now: cornice doctor"
    fi
    ;;

  path)
    printf 'prefix:     %s\n' "$prefix"
    printf 'config dir: %s\n' "$config_dir"
    printf 'user config: %s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/cornice/config.json"
    printf 'socket:     %s\n' "$(socket_path)"
    printf 'quickshell:  %s\n' "$("$qs" --version 2>/dev/null | head -1)"
    ;;

  *)
    echo "cornice: unknown command '$command'" >&2
    usage >&2
    exit 2
    ;;
esac
