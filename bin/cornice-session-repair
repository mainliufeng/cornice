#!/usr/bin/env python3
"""Repackage an intact paired session after an Arch system upgrade, never log out."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tempfile


def run(argv):
    return subprocess.run(list(map(str, argv)), check=True, text=True, capture_output=True).stdout


def checked_member(name):
    parts = Path(name).parts
    return (len(parts) == 3 and parts[:2] == ('usr', 'lib')
            and parts[2].startswith('lib') and '.so' in parts[2]
            and '..' not in parts)


def verify_candidate(release):
    manifest = json.loads((release / 'manifest.json').read_text())
    for relative, expected in manifest['hashes'].items():
        path = (release / relative).resolve()
        if not path.is_relative_to(release.resolve()):
            raise RuntimeError('Snapshot hash path escapes release')
        if hashlib.sha256(path.read_bytes()).hexdigest() != expected:
            raise RuntimeError('Snapshot changed: ' + relative)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--release', type=Path, required=True, help='Intact previous paired release')
    parser.add_argument('--library-package', type=Path, action='append', default=[],
                        help='Official Arch cache package with adjacent .sig; repeat for missing dependencies')
    args = parser.parse_args()
    release = args.release.resolve()
    verify_candidate(release)  # Deliberately check candidate identity, not obsolete system baseline.
    for package in args.library_package:
        run(['pacman-key', '--verify', str(package) + '.sig', package])
    with tempfile.TemporaryDirectory(prefix='cornice-session-repair-') as temporary:
        stage = Path(temporary)
        product = stage / 'cornice'
        shutil.copytree(release / 'cornice', product, symlinks=True)
        libraries = product / 'native/lib/system-upgrade'
        libraries.mkdir(parents=True, exist_ok=True)
        for index, package in enumerate(args.library_package):
            members = [name for name in run(['bsdtar', '-tf', package]).splitlines() if checked_member(name)]
            if not members:
                raise RuntimeError('No shared libraries in ' + str(package))
            extracted = stage / ('package-' + str(index))
            extracted.mkdir()
            run(['bsdtar', '-xf', package, '-C', extracted, '--', *members])
            for name in members:
                source = extracted / name
                resolved = source.resolve()
                if not resolved.is_relative_to(extracted) or not resolved.is_file():
                    raise RuntimeError('Unsafe library link: ' + name)
                target = libraries / source.name
                if target.exists() and target.read_bytes() != resolved.read_bytes():
                    raise RuntimeError('Conflicting library: ' + source.name)
                shutil.copyfile(resolved, target)  # Materialize SONAME links; no external link dependency.
        binary = stage / 'Hyprland'
        shutil.copy2(release / 'Hyprland', binary)
        previous = run(['patchelf', '--print-rpath', binary]).strip()
        paths = ['$ORIGIN/cornice/native/lib/system-upgrade']
        if previous:
            paths.append(previous)
        run(['patchelf', '--set-rpath', ':'.join(paths), binary])
        run([binary, '--version'])
        validation = run([binary, '--verify-config', '-c', release / 'hyprland.lua'])
        if 'config ok' not in validation:
            raise RuntimeError('Configuration did not pass validation: ' + validation)
        # The existing runner records a fresh system baseline and hashes all bundled libraries.
        staged_config = stage / 'hyprland.lua'
        staged_config.write_text((release / 'hyprland.lua').read_text().replace(
            str(release / 'cornice'), str(product)))
        # The session runner relocates product references in the config itself.
        # Autostart references normally point to external apps; refuse product-specific
        # paths rather than silently keep a dependency on the previous snapshot.
        commands = json.loads((release / 'autostart.json').read_text())
        if any(str(release / 'cornice') in command for command in commands):
            raise RuntimeError('Autostart references previous snapshot; migrate those commands first')
        result = run(['python3', release / 'runner', 'prepare', '--hyprland', binary,
                      '--cornice', product, '--config', staged_config,
                      '--autostart', release / 'autostart.json'])
        prepared = Path(json.loads(result)['prepared'])
        config = prepared / 'hyprland.lua'
        verify_candidate(prepared)
        run([prepared / 'Hyprland', '--version'])
        validation = run([prepared / 'Hyprland', '--verify-config', '-c', config])
        if 'config ok' not in validation:
            raise RuntimeError('Prepared configuration failed: ' + validation)
        print(json.dumps({'prepared': str(prepared), 'selected': False,
                          'currentSessionChanged': False}))
        print('Run isolated regression tests before selecting this release for your next login.')


if __name__ == '__main__':
    main()
