#!/usr/bin/env bash
# cornice bar — inspect and edit the bar layout.
#
# The bar is a list of widget entries per section (left/centre/right). Entries are
# kept as objects, so per-widget settings survive a move. Everything here edits
# ~/.config/cornice/config.json (only the `bar.layout` key, merged into whatever
# is there) and then asks the shell to reload, so the change is live.
#
#   cornice bar list                     # what is shown where, and what is available
#   cornice bar show cn.weather          # add a widget (section optional)
#   cornice bar hide cn.weather          # remove it from the bar
#   cornice bar move cn.weather up       # up|down|top|bottom, or left|center|right
#   cornice bar edit                     # open the editor panel
set -uo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
bin_dir=$(dirname "$self")
prefix="${CORNICE_PATH:-$(cd "$bin_dir/.." && pwd)}"
export CORNICE_PATH="$prefix"
export PATH="$bin_dir:$PATH"

. "$bin_dir/cornice-config.sh"
user_config=$(cornice_config_file)

die() { echo "cornice bar: $1" >&2; exit 1; }
need_jq() { command -v jq >/dev/null 2>&1 || die "jq is required"; }

sections=(left center right)

current_layout() { # the effective layout, defaults merged with the user's file
  local raw effective
  raw=$(cornice_config_raw)
  [[ $raw != '{}' || ! -s $user_config ]] || die "config is not valid JSON; refusing to edit it"
  effective=$(cornice_effective_config)
  # Reload is asynchronous; the file contains the latest edits, even when the
  # shell is still showing the previous layout. Preserve defaults for unset sides.
  jq -cn --argjson raw "$raw" --argjson effective "$effective" \
    '$effective.bar.layout + ($raw.bar.layout // {})'
}

available_widgets() {
  timeout 5 cornice widgets 2>/dev/null | jq -r '.[] | "\(.id)\t\(.displayName // .id)\t\(.category // "")"'
}

write_layout() { # write_layout <layout-json>
  need_jq
  cornice_config_edit '.bar.layout = $layout' --argjson layout "$1" || die "could not save the layout"
}

find_section() { # find_section <layout> <id> → section name or empty
  local layout="$1" id="$2" section
  for section in "${sections[@]}"; do
    if jq -e --arg id "$id" --arg s "$section" '.[$s] | map(.id) | index($id)' <<<"$layout" >/dev/null 2>&1; then
      echo "$section"
      return 0
    fi
  done
  return 1
}

command="${1:-list}"
shift || true

case "$command" in
  list)
    need_jq
    layout=$(current_layout) || exit 1
    [[ -n $layout && $layout != "null" ]] || die "the shell is not answering (cornice start)"
    echo "Shown on the bar:"
    for section in "${sections[@]}"; do
      printf '  %-6s ' "$section"
      jq -r --arg s "$section" '.[$s] | map(.id) | join(", ")' <<<"$layout"
    done
    shown=$(jq -r '[.[][]] | map(.id) | join(" ")' <<<"$layout")
    echo
    echo "Available but hidden:"
    while IFS=$'\t' read -r id name _category; do
      [[ -n $id ]] || continue
      case " $shown " in *" $id "*) continue ;; esac
      printf '  %-16s %s\n' "$id" "$name"
    done < <(available_widgets)
    ;;

  show)
    need_jq
    id="${1:-}"; [[ -n $id ]] || die "usage: cornice bar show <widget-id> [--section left|center|right] [--index N]"
    shift || true
    section=""; index=""
    while (($#)); do
      case "$1" in
        --section) (($# >= 2)) || die "--section requires left|center|right"; section="$2"; shift 2 ;;
        --index) (($# >= 2)) || die "--index requires a non-negative integer"; index="$2"; shift 2 ;;
        *) die "unknown option '$1'" ;;
      esac
    done
    layout=$(current_layout) || exit 1

    # Reuse an existing widget and its options; an explicit section takes priority.
    if existing=$(find_section "$layout" "$id"); then
      [[ -n $section ]] || section="$existing"
    fi
    if [[ -z $section ]]; then
      hint=$(timeout 5 cornice widgets 2>/dev/null | jq -r --arg id "$id" '.[] | select(.id==$id) | .defaultSection // "right"' | head -1)
      section="${hint:-right}"
    fi
    case "$section" in left|center|right) ;; *) die "unknown section '$section'" ;; esac
    [[ -z $index || $index =~ ^[0-9]+$ ]] || die "index must be a non-negative integer"
    entry=$(jq -c --arg id "$id" '[.[][] | select(.id == $id)][0] // {id: $id}' <<<"$layout")
    next=$(jq -c --arg s "$section" --argjson e "$entry" --arg id "$id" '
      with_entries(.value |= map(select(.id != $id)))
      | .[$s] = ((.[$s] // []) + [$e])' <<<"$layout")
    if [[ -n $index ]]; then
      next=$(jq -c --arg s "$section" --arg id "$id" --argjson e "$entry" --argjson i "$index" '
        .[$s] = ((.[$s] | map(select(.id != $id))) as $rest
          | $rest[0:$i] + [$e] + $rest[$i:])' <<<"$next")
    fi
    write_layout "$next"
    echo "cornice bar: $id shown in $section"
    ;;

  hide)
    need_jq
    id="${1:-}"; [[ -n $id ]] || die "usage: cornice bar hide <widget-id>"
    layout=$(current_layout) || exit 1
    next=$(jq -c --arg id "$id" '
      with_entries(.value = (.value | map(select(.id != $id))))' <<<"$layout")
    write_layout "$next"
    echo "cornice bar: $id hidden"
    ;;

  move)
    need_jq
    id="${1:-}"; where="${2:-}"; [[ -n $id && -n $where ]] || die "usage: cornice bar move <widget-id> up|down|top|bottom|left|center|right"
    layout=$(current_layout) || exit 1
    section=$(find_section "$layout" "$id") || die "$id is not on the bar"
    case "$where" in
      left | center | right)
        next=$(jq -c --arg from "$section" --arg to "$where" --arg id "$id" '
          if $from == $to then . else
            (.[ $from ] | map(select(.id == $id)) | .[0]) as $entry
            | .[$from] = (.[ $from ] | map(select(.id != $id)))
            | .[$to] = ((.[$to] // []) + [$entry])
          end' <<<"$layout")
        ;;
      top | bottom)
        next=$(jq -c --arg s "$section" --arg id "$id" --arg where "$where" '
          (.[ $s ] | map(select(.id != $id))) as $rest
          | (.[ $s ] | map(select(.id == $id)) | .[0]) as $entry
          | .[ $s ] = (if $where == "top" then [$entry] + $rest else $rest + [$entry] end)' <<<"$layout")
        ;;
      up | down)
        delta=$([[ $where == up ]] && echo -1 || echo 1)
        next=$(jq -c --arg s "$section" --arg id "$id" --argjson d "$delta" '
          (.[ $s ] | map(.id) | index($id)) as $i
          | (.[ $s ]) as $list
          | ($i + $d) as $j
          | if $j < 0 or $j >= ($list | length) then $list
            else $list | (.[$i] = $list[$j]) | (.[$j] = $list[$i]) end as $swapped
          | .[ $s ] = $swapped' <<<"$layout")
        ;;
      *) die "unknown direction '$where'" ;;
    esac
    write_layout "$next"
    echo "cornice bar: $id moved $where"
    ;;

  edit)
    timeout 5 cornice panel cn.bar-editor '{}' >/dev/null 2>&1 || die "could not open the editor"
    echo "cornice bar: editor opened"
    ;;

  -h | --help)
    sed -n '2,16p' "$self" | sed 's/^# \?//'
    ;;

  *)
    die "unknown command '$command' (list|show|hide|move|edit)"
    ;;
esac
