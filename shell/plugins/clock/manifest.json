{
  "schemaVersion": 1,
  "id": "cn.clock",
  "name": "Clock",
  "version": "0.2.0",
  "author": "cornice",
  "description": "Date and time, plus world clocks in the panel; click toggles an alternate format",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Widget.qml",
    "panel": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Clock",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "format": "ddd HH:mm",
      "formatAlt": "HH:mm:ss"
    },
    "schema": [
      {
        "key": "format",
        "type": "string",
        "label": "Qt date format"
      },
      {
        "key": "formatAlt",
        "type": "string",
        "label": "Alternate format (click)"
      },
      {
        "key": "timezone",
        "type": "string",
        "label": "IANA timezone, e.g. Asia/Tokyo (empty = local)"
      },
      {
        "key": "label",
        "type": "string",
        "label": "Optional prefix, e.g. Tokyo"
      }
    ]
  },
  "keepLoaded": true
}
