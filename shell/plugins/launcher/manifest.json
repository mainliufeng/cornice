{
  "schemaVersion": 1,
  "id": "cn.launcher",
  "name": "Launcher",
  "version": "0.3.0",
  "author": "cornice",
  "description": "Application launcher: type to filter, enter to run, with a run-command mode",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Launcher.qml",
    "barWidget": "BarButton.qml"
  },
  "barWidget": {
    "displayName": "Launcher button",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "icon": ""
    },
    "schema": [
      {
        "key": "icon",
        "type": "string",
        "label": "Glyph to show"
      }
    ]
  }
}
