{
  "schemaVersion": 1,
  "id": "cn.media",
  "name": "Media",
  "version": "0.3.0",
  "author": "cornice",
  "description": "Now-playing from MPRIS: click opens a control panel, middle click plays/pauses, scroll skips",
  "kinds": ["service", "bar-widget", "panel"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Widget.qml",
    "panel": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Media",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "maxWidth": 200,
      "format": "{icon} {title}"
    },
    "schema": [
      { "key": "maxWidth", "type": "number", "label": "Maximum width in pixels" },
      { "key": "format", "type": "string", "label": "Format: {icon} {title} {artist}" }
    ]
  }
}
