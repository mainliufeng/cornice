{
  "schemaVersion": 1,
  "id": "cn.workspaces",
  "name": "Workspaces",
  "version": "0.1.0",
  "author": "cornice",
  "description": "Hyprland workspaces, click to switch",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Workspaces",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "minCount": 10
    },
    "schema": [
      {
        "key": "minCount",
        "type": "number",
        "label": "Always show at least this many workspaces"
      }
    ]
  }
}
