{
  "schemaVersion": 1,
  "id": "cn.audio",
  "name": "Audio",
  "version": "0.2.0",
  "author": "cornice",
  "description": "Default sink volume and mute, left click opens the slider panel, right click toggles mute",
  "kinds": [
    "bar-widget",
    "panel"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "Widget.qml",
    "panel": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Audio",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "step": 5
    },
    "schema": [
      {
        "key": "step",
        "type": "number",
        "label": "Volume step in percent"
      }
    ]
  }
}
