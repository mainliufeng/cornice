{
  "schemaVersion": 1,
  "id": "cn.power",
  "name": "Power",
  "version": "0.2.0",
  "author": "cornice",
  "description": "Battery in the bar; battery details, power profile and session actions in a panel",
  "kinds": [
    "bar-widget",
    "panel"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml",
    "panel": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Battery",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showTimeRemaining": false
    },
    "schema": [
      {
        "key": "showTimeRemaining",
        "type": "boolean",
        "label": "Show time remaining"
      }
    ]
  },
  "keepLoaded": true
}
