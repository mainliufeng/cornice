{
  "schemaVersion": 1,
  "id": "cn.agent-desktop",
  "name": "Desktops",
  "version": "0.1.0",
  "author": "cornice",
  "description": "External harness desktops, read-only previews and native takeover",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Widget.qml",
    "panel": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Desktops",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "grouped": true
    }
  },
  "keepLoaded": true
}
